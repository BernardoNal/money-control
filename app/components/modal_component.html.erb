<dialog id="<%= id %>"
        data-modal
        data-modal-open="<%= open? %>"
        aria-modal="true"
        aria-labelledby="<%= title_id %>"
        class="<%= dialog_classes %>">
  <div class="p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <h2 id="<%= title_id %>" class="text-2xl font-semibold text-slate-950"><%= title %></h2>
      <button type="button"
              data-modal-close
              aria-label="<%= close_label %>"
              title="<%= close_label %>"
              class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-slate-500 transition hover:bg-slate-100 hover:text-slate-900">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>

    <div class="mt-6" data-modal-content>
      <%= content %>
    </div>
  </div>
</dialog>
