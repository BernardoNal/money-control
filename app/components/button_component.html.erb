<% if link? %>
  <%= link_to href, class: css_classes, data: data, method: method do %>
    <% if icon.present? %>
      <i class="<%= icon %>"></i>
    <% end %>
    <%= label %>
  <% end %>
<% else %>
  <button type="<%= type %>" class="<%= css_classes %>">
    <% if icon.present? %>
      <i class="<%= icon %>"></i>
    <% end %>
    <%= label %>
  </button>
<% end %>
