<div data-searchable-select
     data-search-url="<%= search_url %>"
     <% if local? %>data-searchable-select-options="<%= json_escape(options.to_json) %>"<% end %>
     data-search-params="<%= json_escape(search_params.to_json) %>">
  <%= form.label attribute, label, class: "mb-1.5 block text-sm font-medium" %>
  <input id="<%= input_id %>"
         type="search"
         value="<%= selected_text %>"
         placeholder="<%= placeholder %>"
         autocomplete="off"
         role="combobox"
         aria-autocomplete="list"
         aria-expanded="false"
         aria-controls="<%= input_id %>_results"
         <%= "required" if local? %>
         data-searchable-select-input
         class="block w-full">
  <%= form.hidden_field attribute, value: selected_id, data: { searchable_select_value: true } %>
  <div id="<%= input_id %>_results"
       role="listbox"
       data-searchable-select-results
       class="relative z-10 mt-1 hidden max-h-60 overflow-auto rounded-xl border border-slate-200 bg-white shadow-lg">
  </div>
  <p class="mt-1 hidden text-sm text-rose-600" data-searchable-select-error></p>
</div>
