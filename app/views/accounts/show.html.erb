<div class="mx-auto w-full max-w-5xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <%= render ButtonComponent.new(label: "Voltar para contas", href: accounts_path, variant: :soft_olive, icon: "fa-solid fa-arrow-left") %>
        <p class="mt-6 text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Conta</p>
        <h1 class="mt-3 text-3xl font-semibold text-slate-950"><%= @account.name %></h1>
        <p class="mt-2 text-sm text-slate-600"><%= @account.bank %></p>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= render ButtonComponent.new(label: "Editar", href: edit_account_path(@account), variant: :primary, icon: "fa-solid fa-pen-to-square") %>
        <%= render ButtonComponent.new(label: "Apagar", href: account_path(@account), variant: :danger, icon: "fa-solid fa-trash", data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja apagar esta conta?" }) %>
      </div>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Saldo inicial</p>
        <p class="mt-2 text-2xl font-semibold text-slate-950"><%= number_to_currency(@account.initial_balance, unit: "R$ ", separator: ",", delimiter: ".") %></p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Tipo de cartao</p>
        <p class="mt-2 text-lg font-semibold text-slate-950"><%= @account.card_type.presence || "-" %></p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Ultimos digitos</p>
        <p class="mt-2 text-lg font-semibold text-slate-950"><%= @account.last_digits.presence || "-" %></p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Limite</p>
        <p class="mt-2 text-2xl font-semibold text-slate-950"><%= @account.limit.present? ? number_to_currency(@account.limit, unit: "R$ ", separator: ",", delimiter: ".") : "-" %></p>
      </div>
    </div>

  </section>
</div>
