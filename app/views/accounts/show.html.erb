<div class="mx-auto w-full max-w-5xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <%= render ButtonComponent.new(label: "Voltar para contas", href: accounts_path, variant: :soft_olive, icon: "fa-solid fa-arrow-left") %>
        <p class="mt-6 text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Conta</p>
        <h1 class="mt-3 text-3xl font-semibold text-slate-950"><%= @account.name %></h1>
        <p class="mt-2 text-sm text-slate-600"><%= @account.bank %></p>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= render ButtonComponent.new(label: "Importar CSV", href: account_transaction_import_path(@account), variant: :soft_olive, icon: "fa-solid fa-file-import") %>
        <%= render ButtonComponent.new(label: "Editar", href: edit_account_path(@account), variant: :primary, icon: "fa-solid fa-pen-to-square") %>
        <%= render ButtonComponent.new(label: "Apagar", href: account_path(@account), variant: :danger, icon: "fa-solid fa-trash", data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja apagar esta conta?" }) %>
      </div>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Saldo inicial</p>
        <p class="mt-2 text-2xl font-semibold text-slate-950"><%= number_to_currency(@account.initial_balance, unit: "R$ ", separator: ",", delimiter: ".") %></p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Tipo de cartão</p>
        <p class="mt-2 text-lg font-semibold text-slate-950"><%= @account.card_type.presence || "-" %></p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Últimos digitos</p>
        <p class="mt-2 text-lg font-semibold text-slate-950"><%= @account.last_digits.presence || "-" %></p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Limite</p>
        <p class="mt-2 text-2xl font-semibold text-slate-950"><%= @account.limit.present? ? number_to_currency(@account.limit, unit: "R$ ", separator: ",", delimiter: ".") : "-" %></p>
      </div>
    </div>

    <% if @pending_transaction_imports.present? %>
      <div class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-5">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="text-lg font-semibold text-slate-950">Importações pendentes</h2>
            <p class="mt-1 text-sm text-slate-600">Retome uma revisão ou cancele um arquivo que não deseja importar.</p>
          </div>
        </div>
        <div class="mt-4 divide-y divide-amber-200">
          <% @pending_transaction_imports.each do |transaction_import| %>
            <div class="flex flex-col gap-3 py-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="font-semibold text-slate-900"><%= transaction_import.original_filename %></p>
                <p class="mt-1 text-sm text-slate-600"><%= transaction_import.rows.size %> linhas · criado em <%= transaction_import.created_at.strftime("%d/%m/%Y %H:%M") %></p>
              </div>
              <div class="flex flex-wrap gap-2">
                <%= render ButtonComponent.new(label: "Retomar", href: account_transaction_import_preview_path(@account, transaction_import), variant: :primary, icon: "fa-solid fa-arrow-right") %>
                <%= render ButtonComponent.new(label: "Cancelar", href: account_transaction_import_cancel_path(@account, transaction_import), variant: :soft_olive, icon: "fa-solid fa-xmark", data: { turbo_method: :delete, turbo_confirm: "Cancelar esta importação?" }) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-lg font-semibold text-slate-950">Transações recentes</h2>
          <p class="mt-1 text-sm text-slate-600">Últimas movimentações registradas nesta conta.</p>
        </div>
        <%= render ButtonComponent.new(label: "Nova transação", href: new_transaction_path, variant: :soft_olive, icon: "fa-solid fa-plus") %>
      </div>

      <% if @transactions.any? %>
        <div class="mt-4 divide-y divide-slate-200">
          <% @transactions.each do |transaction| %>
            <%= link_to transaction_path(transaction), class: "flex flex-col gap-2 py-4 no-underline sm:flex-row sm:items-center sm:justify-between" do %>
              <div>
                <p class="font-semibold text-slate-900"><%= transaction.description %></p>
                <p class="mt-1 text-sm text-slate-500"><%= transaction.category&.name || "Sem categoria" %> · <%= transaction.date.strftime("%d/%m/%Y") %></p>
              </div>
              <p class="font-semibold <%= transaction.amount.negative? ? "text-rose-600" : "text-emerald-700" %>"><%= number_to_currency(transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %></p>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="mt-4 rounded-xl bg-slate-50 p-4 text-sm text-slate-600">Nenhuma transação registrada nesta conta.</p>
      <% end %>
    </div>

  </section>
</div>
