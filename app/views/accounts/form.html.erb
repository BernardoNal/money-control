<div class="mx-auto w-full max-w-6xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <div>
      <%= render ButtonComponent.new(label: "Voltar para contas", href: accounts_path, variant: :soft_olive, icon: "fa-solid fa-arrow-left") %>
      <p class="mt-6 text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Contas</p>
      <h1 class="mt-3"><%= @account.persisted? ? "Editar conta" : "Nova conta" %></h1>
    </div>

    <div class="mt-8">
      <%= form_with model: @account, local: true do |f| %>
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          <div>
            <%= f.label :name, "Nome", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.text_field :name, class: "w-full", placeholder: "Principal, CC...", required: true %>
          </div>

          <div>
            <%= f.label :bank, "Banco", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.text_field :bank, class: "w-full", placeholder: "BB, C6, Nubank...", required: true %>
          </div>

          <div>
            <%= f.label :initial_balance, "Saldo inicial", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.number_field :initial_balance, step: 0.01, class: "w-full", placeholder: "0,00", required: true %>
          </div>

          <div>
            <%= f.label :card_type, "Categoria do cartão", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.text_field :card_type, class: "w-full", placeholder: "Gold..." %>
          </div>

          <div>
            <%= f.label :last_digits, "Últimos digitos", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.text_field :last_digits, class: "w-full", placeholder: "1234" %>
          </div>

          <div>
            <%= f.label :limit, "Limite no cartão", class: "mb-1.5 block text-sm font-medium " %>
            <div class="relative">
              <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-sm font-medium text-slate-500">R$</span>
              <%= f.number_field :limit, step: 0.01, min: 0, class: "w-full pl-12", placeholder: "100,00" %>
            </div>
          </div>

          <div>
            <%= f.label :due_day, "Mes de vencimento", class: "mb-1.5 block font-medium " %>
            <%= f.month_field :due_day, class: "w-full" %>
          </div>
        </div>

        <div class="mt-8 flex justify-center">
          <%= f.button :submit, class: "inline-flex items-center justify-center rounded-full bg-[#000080] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#000066] focus:outline-none focus:ring-4 focus:ring-blue-200" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
