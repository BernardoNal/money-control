<div class="mx-auto w-full max-w-7xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Contas</p>
        <h1 class="mt-3 text-3xl font-semibold text-slate-950">Minhas contas</h1>
        <p class="mt-2 text-sm leading-6 text-slate-600">Acompanhe saldos e as movimentacoes mais recentes de cada conta.</p>
      </div>

      <%= render ButtonComponent.new(label: "Nova conta", href: new_account_path, variant: :primary, icon: "fa-solid fa-circle-plus") %>
    </div>

    <% if @accounts.any? %>
      <div class="mt-8 grid gap-5 lg:grid-cols-2 xl:grid-cols-3">
        <% @accounts.each do |account| %>
          <article class="rounded-3xl border border-slate-200 bg-slate-50 p-6">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-xl font-semibold text-slate-950"><%= account.name %></h2>
                <p class="mt-1 text-sm text-slate-500"><%= account.bank %></p>
              </div>
              <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500 ring-1 ring-slate-200">Conta</span>
            </div>

            <div class="mt-5">
              <p class="text-sm text-slate-500">Saldo total</p>
              <p class="mt-2 text-2xl font-semibold text-slate-950"><%= number_to_currency(account.total_balance, unit: "R$ ", separator: ",", delimiter: ".") %></p>
            </div>

            <div class="mt-5">
              <p class="text-sm font-medium text-slate-700">Ultimas transacoes</p>
              <% recent_transactions = account.transactions.order(created_at: :desc).limit(5) %>
              <% if recent_transactions.any? %>
                <ul class="mt-3 space-y-2">
                  <% recent_transactions.each do |transaction| %>
                    <li class="flex items-center justify-between gap-3 rounded-2xl bg-white px-3 py-2 text-sm">
                      <span class="truncate text-slate-700"><%= transaction.description %></span>
                      <span class="<%= transaction.amount.negative? ? 'text-rose-600' : 'text-emerald-600' %> font-medium">
                        <%= number_to_currency(transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %>
                      </span>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <div class="mt-3 rounded-2xl border border-dashed border-slate-300 bg-white px-4 py-5 text-sm text-slate-500">
                  Nenhuma transacao registrada para esta conta.
                </div>
              <% end %>
            </div>

            <div class="mt-6">
              <%= render ButtonComponent.new(label: "Ver detalhes", href: account_path(account), variant: :soft_olive, icon: "fa-solid fa-arrow-right", classes: "text-slate-700 hover:text-slate-900") %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="mt-8 rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center">
        <h2 class="text-xl font-semibold text-slate-950">Nenhuma conta cadastrada</h2>
        <p class="mt-2 text-sm text-slate-600">Crie sua primeira conta para acompanhar saldos e movimentacoes.</p>
      </div>
    <% end %>
  </div>
</div>
