<div class="mx-auto w-full max-w-5xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <%= render ButtonComponent.new(label: "Voltar para transações", href: transactions_path, variant: :soft_olive, icon: "fa-solid fa-arrow-left") %>
        <p class="mt-6 text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Transação</p>
        <h1 class="mt-3 text-3xl font-semibold text-slate-950"><%= @transaction.description %></h1>
        <p class="mt-2 text-3xl font-semibold <%= @transaction.amount.negative? ? 'text-rose-600' : 'text-emerald-600' %>">
          <%= number_to_currency(@transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %>
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= render ButtonComponent.new(label: "Editar", href: edit_transaction_path(@transaction), variant: :primary, icon: "fa-solid fa-pen-to-square") %>
        <%= render ButtonComponent.new(label: "Apagar", href: transaction_path(@transaction), variant: :danger, icon: "fa-solid fa-trash", data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja apagar esta transação?" }) %>
      </div>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Data</p>
        <p class="mt-2 text-lg font-semibold text-slate-950"><%= l(@transaction.date) %></p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Recebedor/Pagador</p>
        <p class="mt-2 text-lg font-semibold text-slate-950"><%= @transaction.to_whom.presence || "-" %></p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Metodo de pagamento</p>
        <p class="mt-2 text-lg font-semibold text-slate-950"><%= @transaction.payment_method.presence || "-" %></p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Conta</p>
        <p class="mt-2 text-lg font-semibold text-slate-950"><%= "#{@transaction.account.name} - #{@transaction.account.bank}" %></p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Categoria</p>
        <p class="mt-2 text-lg font-semibold text-slate-950"><%= @transaction.category.name %></p>
      </div>
    </div>
  </section>
</div>
