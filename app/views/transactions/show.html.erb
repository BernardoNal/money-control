<div class="mx-auto w-full max-w-6xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-6 shadow-sm sm:p-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <%= render ButtonComponent.new(label: "Voltar para transações", href: transactions_path, variant: :soft_olive, icon: "fa-solid fa-arrow-left") %>
        <p class="mt-7 text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Detalhes da transação</p>
        <h1 class="mt-3 max-w-2xl break-words text-3xl font-semibold text-slate-950"><%= @transaction.description %></h1>
        <p class="mt-3 text-3xl font-semibold <%= @transaction.amount.negative? ? 'text-rose-600' : 'text-emerald-600' %>">
          <%= number_to_currency(@transaction.amount, unit: "R$ ", separator: ",", delimiter: ".") %>
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= render ButtonComponent.new(label: "Editar", href: edit_transaction_path(@transaction), variant: :primary, icon: "fa-solid fa-pen-to-square") %>
        <%= render ButtonComponent.new(label: "Apagar", href: transaction_path(@transaction), variant: :danger, icon: "fa-solid fa-trash", data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja apagar esta transação?" }) %>
      </div>
    </div>

    <div class="mt-8">
      <%= render "details", transaction: @transaction %>
    </div>
  </section>
</div>
