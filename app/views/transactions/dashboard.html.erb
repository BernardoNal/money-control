<div class="mx-auto w-full max-w-7xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Dashboard</p>
        <h1 class="mt-3 text-4xl font-semibold">Sua central financeira</h1>
        <p class="mt-3 text-base leading-7">
          Acompanhe rapidamente os modulos principais e siga para contas, categorias, transações ou investimentos com a mesma linguagem visual do restante da aplicação.
        </p>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <%= link_to transactions_path, class: "rounded-3xl border border-slate-200 bg-slate-50 p-5 no-underline transition hover:border-slate-300 hover:bg-slate-100" do %>
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-[#000080]/10 text-[#000080]">
              <i class="fa-solid fa-arrow-right-arrow-left"></i>
            </div>
            <div>
              <p class="text-sm font-semibold">Transações</p>
              <p class="text-sm">Veja movimentações recentes.</p>
            </div>
          </div>
        <% end %>

        <%= link_to investments_portfolios_path, class: "rounded-3xl border border-slate-200 bg-slate-50 p-5 no-underline transition hover:border-slate-300 hover:bg-slate-100" do %>
          <div class="flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-500/10 text-emerald-700">
              <i class="fa-solid fa-chart-pie"></i>
            </div>
            <div>
              <p class="text-sm font-semibold">Investimentos</p>
              <p class="text-sm">Acesse a carteira consolidada.</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <%= link_to accounts_path, class: "rounded-3xl border border-slate-200 bg-white p-6 no-underline transition hover:border-slate-300 hover:shadow-sm" do %>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Contas</p>
        <h2 class="mt-3">Gestão de saldos</h2>
        <p class="mt-3 text-sm leading-6">Consulte contas cadastradas, bancos e movimentações mais recentes.</p>
      <% end %>

      <%= link_to categories_path, class: "rounded-3xl border border-slate-200 bg-white p-6 no-underline transition hover:border-slate-300 hover:shadow-sm" do %>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Categorias</p>
        <h2 class="mt-3">Organização</h2>
        <p class="mt-3 text-sm leading-6">Mantenha entradas e saidas classificadas com clareza e consistencia.</p>
      <% end %>

      <%= link_to investments_portfolios_path, class: "rounded-3xl border border-slate-200 bg-white p-6 no-underline transition hover:border-slate-300 hover:shadow-sm" do %>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-500">Carteira</p>
        <h2 class="mt-3">Visão de patrimonio</h2>
        <p class="mt-3 text-sm leading-6">Continue para o dashboard de investimentos e acompanhe alocação e evolução.</p>
      <% end %>
    </div>
  </section>
</div>
