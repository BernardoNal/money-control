<div class="mx-auto w-full max-w-6xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <%= link_to "Voltar para a conta", account_path(@account), class: "text-sm font-semibold text-slate-600 hover:text-slate-950" %>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Revisão da importação</p>
        <h1 class="mt-3 text-3xl font-semibold text-slate-950"><%= @transaction_import.original_filename %></h1>
        <p class="mt-2 text-slate-600">Conta: <%= @account.name %></p>
      </div>
      <div class="text-sm text-slate-500">Nenhuma transação foi criada ainda.</div>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <% { "valid" => ["Válidas", "text-emerald-700"], "invalid" => ["Com erro", "text-red-700"], "ignored" => ["Ignoradas", "text-slate-600"] }.each do |status, (label, color)| %>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-sm text-slate-500"><%= label %></p>
          <p class="mt-1 text-2xl font-semibold <%= color %>"><%= @transaction_import.summary[status].to_i %></p>
        </div>
      <% end %>
    </div>

    <% if flash[:alert].present? %>
      <div class="mt-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert"><%= flash[:alert] %></div>
    <% end %>

    <%= form_with url: account_transaction_import_update_path(@account, @transaction_import), method: :patch, class: "mt-8" do |form| %>
      <div class="overflow-x-auto rounded-2xl border border-slate-200">
        <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-4 py-3">Linha</th>
              <th class="px-4 py-3">Data</th>
              <th class="px-4 py-3">Lançamento</th>
              <th class="px-4 py-3">Detalhes</th>
              <th class="px-4 py-3">Documento</th>
              <th class="px-4 py-3">Valor</th>
              <th class="px-4 py-3">Tipo</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Categoria</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @transaction_import.rows.each do |row| %>
              <tr>
                <td class="px-4 py-4 text-slate-500"><%= row["line_number"] %></td>
                <td class="px-4 py-4 text-slate-700"><%= row["date"].present? ? Date.parse(row["date"]).strftime("%d/%m/%Y") : "-" %></td>
                <td class="px-4 py-4 font-medium text-slate-900"><%= row["description"].presence || row["ignored_reason"] || "-" %></td>
                <td class="max-w-xs px-4 py-4 text-slate-600"><%= row["to_whom"].presence || "-" %></td>
                <td class="px-4 py-4 text-slate-600"><%= row["document_number"].presence || "-" %></td>
                <td class="px-4 py-4 text-slate-700"><%= row["amount"].present? ? number_to_currency(row["amount"], unit: "R$ ", separator: ",", delimiter: ".") : "-" %></td>
                <td class="px-4 py-4 text-slate-600"><%= row["transaction_type"].presence || "-" %></td>
                <td class="px-4 py-4">
                  <span class="font-semibold <%= { "valid" => "text-emerald-700", "invalid" => "text-red-700", "ignored" => "text-slate-500" }.fetch(row["status"], "text-slate-700") %>"><%= { "valid" => "Válida", "invalid" => "Com erro", "ignored" => "Ignorada" }.fetch(row["status"], row["status"]) %></span>
                  <% if row["errors"].present? %><p class="mt-1 text-xs text-red-700"><%= row["errors"].to_sentence %></p><% end %>
                </td>
                <td class="px-4 py-4">
                  <% if row["status"] == "valid" %>
                    <%= select_tag "row_categories[#{row["line_number"]}]", options_from_collection_for_select(@categories, :id, :name, row["category_id"]), include_blank: "Selecione", class: "w-52 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" %>
                  <% else %>
                    <span class="text-slate-400">-</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <%= form.submit "Salvar categorias da revisão", class: "inline-flex items-center rounded-xl bg-slate-950 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-800" %>
        <%= render ButtonComponent.new(label: "Cancelar", href: account_path(@account), variant: :soft_olive, icon: "fa-solid fa-xmark") %>
      </div>
    <% end %>
  </section>
</div>
