<div class="mx-auto w-full max-w-4xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <%= link_to "Voltar para a conta", account_path(@account), class: "text-sm font-semibold text-slate-600 hover:text-slate-950" %>
    <p class="mt-8 text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Importação de transações</p>
    <h1 class="mt-3 text-3xl font-semibold text-slate-950">Carregar CSV em <%= @account.name %></h1>
    <p class="mt-3 max-w-2xl text-slate-600">O arquivo será revisado antes de qualquer transação ser criada nesta conta.</p>

    <% if @upload_error.present? %>
      <div class="mt-6 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert"><%= @upload_error %></div>
    <% end %>

    <%= form_with model: @transaction_import, url: account_transaction_import_create_path(@account), multipart: true, class: "mt-8 space-y-6" do |form| %>
      <div>
        <%= form.label :file, "Arquivo CSV", class: "block text-sm font-semibold text-slate-900" %>
        <%= form.file_field :file, accept: ".csv,text/csv", required: true, class: "mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-700 file:mr-4 file:rounded-lg file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:font-semibold file:text-slate-700" %>
      </div>
      <%= form.submit "Continuar para revisão", class: "inline-flex items-center rounded-xl bg-slate-950 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-800" %>
    <% end %>
  </section>
</div>
