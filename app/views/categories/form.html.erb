<div class="mx-auto w-full max-w-5xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <div>
      <%= link_to categories_path, class: "inline-flex items-center gap-2 rounded-full border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 no-underline transition hover:bg-slate-100 hover:text-slate-900" do %>
        <i class="fa-solid fa-arrow-left"></i>
        Voltar para categorias
      <% end %>
      <p class="mt-6 text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Categorias</p>
      <h1 class="mt-3"><%= @category.persisted? ? "Editar categoria" : "Nova categoria" %></h1>
    </div>

    <div class="mt-8">
      <%= form_with model: @category, local: true do |f| %>
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
          <div class="xl:col-span-2">
            <%= f.label :name, "Nome da categoria", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.text_field :name, class: "w-full", placeholder: "Energia, lanche, estudos" %>
          </div>

          <div>
            <%= f.label :is_income, "Tipo", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.select :is_income, [["Entrada", true], ["Saida", false]], {}, class: "w-full" %>
          </div>

          <div>
            <%= f.label :icon, "Icone", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.select :icon, Category::ICONS.map { |i| [i, i] }, {}, class: "w-full" %>
          </div>

          <div>
            <%= f.label :color, "Cor da categoria", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.color_field :color, class: "h-12 w-20 cursor-pointer rounded-2xl border border-slate-300 bg-white p-1" %>
          </div>
        </div>

        <div class="mt-8 flex justify-center">
          <%= f.button :submit, class: "inline-flex items-center justify-center rounded-full bg-[#000080] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#000066] focus:outline-none focus:ring-4 focus:ring-blue-200" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
