              <%= link_to item[:path], class: "flex items-center justify-between gap-3 rounded-2xl px-4 py-3 text-sm font-medium no-underline transition #{item[:active].call ? 'bg-white text-slate-950 shadow-sm' : 'bg-slate-900 text-slate-200 ring-1 ring-slate-700 hover:bg-slate-800 hover:text-white'}", data: { mobile_nav_close: true } do %>
