              <% end %>
            <% end %>
          </div>
        </section>

        <section>
          <details class="group rounded-3xl border border-slate-800 bg-slate-900/80 p-2" <%= "open" if investments_navigation_items.any? { |item| item[:active].call } %>>
            <summary class="flex cursor-pointer items-center justify-between gap-3 rounded-2xl px-3 py-3 text-sm font-medium text-slate-200 transition hover:bg-slate-800 hover:text-white">
              <span class="flex items-center gap-3">
                <i class="fa-solid fa-chart-pie w-4"></i>
                <span>Investimentos</span>
              </span>
              <i class="fa-solid fa-chevron-down text-xs transition group-open:rotate-180"></i>
