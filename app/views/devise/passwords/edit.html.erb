<div class="mx-auto w-full max-w-xl py-8">
  <div class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Seguranca</p>
    <h2 class="mt-3 text-3xl font-semibold text-slate-950">Definir nova senha</h2>
    <p class="mt-2 text-sm leading-6 text-slate-500">Escolha uma nova senha para voltar ao fluxo normal da aplicação.</p>

    <div class="mt-8">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="space-y-5">
          <div>
            <%= f.label :password, "Nova senha", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
            <% if @minimum_password_length %>
              <p class="mb-2 text-xs text-slate-500">Use pelo menos <%= @minimum_password_length %> caracteres.</p>
            <% end %>
            <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full" %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirmar nova senha", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full" %>
          </div>

          <%= f.submit "Alterar senha", class: "inline-flex w-full items-center justify-center rounded-full bg-[#000080] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#000066] focus:outline-none focus:ring-4 focus:ring-blue-200" %>
        </div>
      <% end %>
    </div>

    <div class="mt-6 border-t border-slate-200 pt-6 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
