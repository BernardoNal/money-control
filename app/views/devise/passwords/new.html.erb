<div class="mx-auto w-full max-w-xl py-8">
  <div class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Recuperacao</p>
    <h2 class="mt-3 text-3xl font-semibold text-slate-950">Esqueceu sua senha?</h2>
    <p class="mt-2 text-sm leading-6 text-slate-500">Informe seu e-mail para receber as instrucoes de redefinicao.</p>

    <div class="mt-8">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, "E-mail", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full" %>
        </div>

        <div class="mt-8">
          <%= f.submit "Enviar instrucoes", class: "inline-flex w-full items-center justify-center rounded-full bg-[#000080] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#000066] focus:outline-none focus:ring-4 focus:ring-blue-200" %>
        </div>
      <% end %>
    </div>

    <div class="mt-6 border-t border-slate-200 pt-6 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
