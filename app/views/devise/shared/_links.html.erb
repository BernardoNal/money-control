<div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm">
  <%- if controller_name != "sessions" %>
    <%= link_to "Entrar", new_session_path(resource_name), class: "font-medium text-slate-600 no-underline transition hover:text-slate-900" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Criar conta", new_registration_path(resource_name), class: "font-medium text-slate-600 no-underline transition hover:text-slate-900" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to "Esqueci minha senha", new_password_path(resource_name), class: "font-medium text-slate-600 no-underline transition hover:text-slate-900" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != "confirmations" %>
    <%= link_to "Reenviar confirmação", new_confirmation_path(resource_name), class: "font-medium text-slate-600 no-underline transition hover:text-slate-900" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != "unlocks" %>
    <%= link_to "Reenviar desbloqueio", new_unlock_path(resource_name), class: "font-medium text-slate-600 no-underline transition hover:text-slate-900" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Entrar com #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "font-medium text-slate-600 transition hover:text-slate-900" %>
    <% end %>
  <% end %>
</div>
