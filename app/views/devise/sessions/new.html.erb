<div class="mx-auto w-full max-w-5xl py-8">
  <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
    <section class="hidden lg:block">
      <div class="max-w-xl">
        <div class="inline-flex items-center gap-4 rounded-full border border-slate-300 bg-white px-5 py-3 shadow-sm">
          <img src="<%= asset_path('$$$.png') %>" class="h-12 w-12 object-contain" alt="Money Control" />
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.34em] text-slate-500">Plataforma</p>
            <p class="text-2xl font-semibold tracking-[0.18em]">MONEY CONTROL</p>
          </div>
        </div>
        <h1 class="mt-4 text-5xl font-semibold leading-tight">Organize sua vida financeira em um fluxo claro, direto e consistente.</h1>
        <p class="mt-6 max-w-lg text-lg leading-8">
          Do acompanhamento do dia a dia ao modulo de investimentos, a experiencia agora segue a mesma linguagem visual e a mesma sensação de controle.
        </p>
      </div>
    </section>

    <section class="mx-auto w-full max-w-xl">
      <div class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Acesso</p>
        <h2 class="mt-3 text-3xl font-semibold">Entrar</h2>
        <p class="mt-2 text-sm leading-6 text-slate-500">Use seu e-mail e senha para continuar.</p>

        <div class="mt-8">
          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="space-y-5">
              <div>
                <%= f.label :email, "E-mail", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full" %>
              </div>

              <div>
                <%= f.label :password, "Senha", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
                <%= f.password_field :password, autocomplete: "current-password", class: "w-full" %>
              </div>

              <% if devise_mapping.rememberable? %>
                <label class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
                  <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" %>
                  <span>Manter sessao ativa</span>
                </label>
              <% end %>

              <%= f.submit "Entrar", class: "inline-flex w-full items-center justify-center rounded-full bg-[#000080] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#000066] focus:outline-none focus:ring-4 focus:ring-blue-200" %>
            </div>
          <% end %>
        </div>

        <div class="mt-6 border-t border-slate-200 pt-6 text-center">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </section>
  </div>
</div>
