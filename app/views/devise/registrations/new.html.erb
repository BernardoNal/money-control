<div class="mx-auto w-full max-w-2xl py-8">
  <div class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Cadastro</p>
    <h1 class="mt-3 text-3xl font-semibold text-slate-950">Criar conta</h1>
    <p class="mt-2 text-sm leading-6 text-slate-500">Comece com uma base organizada para contas, transações e investimentos.</p>

    <div class="mt-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="grid gap-5 md:grid-cols-2">
          <div class="md:col-span-2">
            <%= f.label :name, "Nome", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
            <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "w-full" %>
          </div>

          <div class="md:col-span-2">
            <%= f.label :email, "E-mail", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
            <%= f.email_field :email, autocomplete: "email", class: "w-full" %>
          </div>

          <div>
            <%= f.label :password, "Senha", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
            <% if @minimum_password_length %>
              <p class="mb-2 text-xs text-slate-500">Use pelo menos <%= @minimum_password_length %> caracteres.</p>
            <% end %>
            <%= f.password_field :password, autocomplete: "new-password", class: "w-full" %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirmação da senha", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full" %>
          </div>
        </div>

        <div class="mt-8">
          <%= f.submit "Criar conta", class: "inline-flex w-full items-center justify-center rounded-full bg-[#000080] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#000066] focus:outline-none focus:ring-4 focus:ring-blue-200" %>
        </div>
      <% end %>
    </div>

    <div class="mt-6 border-t border-slate-200 pt-6 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
