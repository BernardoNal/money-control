<div class="mx-auto w-full max-w-4xl py-8">
  <div class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Perfil</p>
    <h1 class="mt-3 text-3xl font-semibold text-slate-950">Minha conta</h1>

    <div class="mt-8">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="grid gap-5 md:grid-cols-2">
          <div>
            <%= f.label :name, "Nome", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
            <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "w-full" %>
          </div>

          <div>
            <%= f.label :email, "E-mail", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
            <%= f.email_field :email, autocomplete: "email", class: "w-full" %>
          </div>

          <div>
            <%= f.label :password, "Nova senha", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
            <div class="min-h-10">
              <p class="mb-2 text-xs text-slate-500">Deixe em branco se nao quiser alterar.</p>
              <% if @minimum_password_length %>
                <p class="mb-2 text-xs text-slate-500">Minimo de <%= @minimum_password_length %> caracteres.</p>
              <% end %>
            </div>
            <%= f.password_field :password, autocomplete: "new-password", class: "w-full" %>
          </div>

          <div>
            <%= f.label :password_confirmation, "Confirmacao da senha", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
            <div class="mb-2 min-h-10"></div>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full" %>
          </div>

          <div class="md:col-span-2">
            <%= f.label :current_password, "Senha atual", class: "mb-1.5 block text-sm font-medium text-slate-900" %>
            <p class="mb-2 text-xs text-slate-500">Precisamos dela para confirmar as alteracoes.</p>
            <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full" %>
          </div>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div class="mt-5 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
            Confirmacao pendente para: <%= resource.unconfirmed_email %>
          </div>
        <% end %>

        <div class="mt-8 flex justify-center">
          <%= f.submit "Salvar alteracoes", class: "inline-flex items-center justify-center rounded-full bg-[#000080] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#000066] focus:outline-none focus:ring-4 focus:ring-blue-200" %>
        </div>
      <% end %>
    </div>

    <div class="mt-8 border-t border-slate-200 pt-8">
      <div class="flex justify-center">
        <%= button_to "Cancelar minha conta", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete, class: "inline-flex items-center justify-center rounded-full bg-rose-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-rose-700 focus:outline-none focus:ring-4 focus:ring-rose-200" %>
      </div>
    </div>
  </div>
</div>
