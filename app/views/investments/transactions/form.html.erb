<div class="container mt-6 max-w-4xl">
  <%= link_to investments_transactions_path, class: "inline-flex items-center gap-2 rounded-full bg-gray-900 px-4 py-2 text-sm text-white text-decoration-none transition hover:bg-gray-700" do %>
    <i class="fa-solid fa-circle-left"></i>Voltar
  <% end %>

  <div class="mt-5 overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm">
    <div class="border-b border-gray-100 bg-gradient-to-r from-slate-50 to-white px-6 py-5">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Investimentos</p>

      <h1 class="mt-2 text-3xl font-semibold text-gray-900">
        <%= @transaction.persisted? ? "Editar Movimentação" : "Nova Movimentação" %>
      </h1>

      <p class="mt-2 max-w-xl text-sm text-gray-600">
        Registre compras, vendas, transferências e demais eventos dos seus investimentos.
      </p>
    </div>

    <div class="px-6 py-6">
      <%= form_with model: @transaction, local: true do |f| %>

        <% if @transaction.errors.any? %>
          <div class="mb-6 rounded-2xl border border-red-300 bg-red-50 p-4 text-red-700">
            <p class="font-semibold">Não foi possível salvar a movimentação:</p>

            <ul class="mt-2 list-disc pl-5">
              <% @transaction.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">

          <div>
            <%= f.label :portfolio_id,
                        t("activerecord.attributes.investments/transaction.portfolio"),
                        class: "mb-2 block text-sm font-medium text-gray-900" %>

            <%= f.select :portfolio_id,
                         options_from_collection_for_select(
                           @portfolios,
                           :id,
                           :name,
                           @transaction.portfolio_id
                         ),
                         { prompt: "Selecione uma carteira" },
                         class: "block w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
          </div>

          <div>
            <%= f.label :asset_id,
                        t("activerecord.attributes.investments/transaction.asset"),
                        class: "mb-2 block text-sm font-medium text-gray-900" %>

            <%= f.select :asset_id,
                         options_from_collection_for_select(
                           @assets,
                           :id,
                           :symbol,
                           @transaction.asset_id
                         ),
                         { prompt: "Selecione um ativo" },
                         class: "block w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
          </div>

          <div>
            <%= f.label :transaction_type,
                        t("activerecord.attributes.investments/transaction.transaction_type"),
                        class: "mb-2 block text-sm font-medium text-gray-900" %>

            <%= f.select :transaction_type,
                         options_for_select(
                           @transaction_types,
                           @transaction.transaction_type
                         ),
                         { prompt: "Selecione um tipo" },
                         class: "block w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
          </div>

          <div>
            <%= f.label :date,
                        t("activerecord.attributes.investments/transaction.date"),
                        class: "mb-2 block text-sm font-medium text-gray-900" %>

            <%= f.date_field :date,
                             class: "block w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
          </div>

          <div>
            <%= f.label :quantity,
                        t("activerecord.attributes.investments/transaction.quantity"),
                        class: "mb-2 block text-sm font-medium text-gray-900" %>

            <%= f.number_field :quantity,
                               step: :any,
                               min: 0,
                               class: "block w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
          </div>

          <div>
            <%= f.label :price,
                        t("activerecord.attributes.investments/transaction.price"),
                        class: "mb-2 block text-sm font-medium text-gray-900" %>

            <%= f.number_field :price,
                               step: :any,
                               min: 0,
                               class: "block w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
          </div>

          <div>
            <%= f.label :fees,
                        t("activerecord.attributes.investments/transaction.fees"),
                        class: "mb-2 block text-sm font-medium text-gray-900" %>

            <%= f.number_field :fees,
                               step: :any,
                               min: 0,
                               class: "block w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
          </div>

        </div>

        <div class="mt-5">
          <%= f.label :notes,
                      t("activerecord.attributes.investments/transaction.notes"),
                      class: "mb-2 block text-sm font-medium text-gray-900" %>

          <%= f.text_area :notes,
                          rows: 4,
                          class: "block w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100",
                          placeholder: "Observações opcionais..." %>
        </div>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm text-gray-500">
            As movimentações serão utilizadas para cálculo de posição e preço médio.
          </p>

          <div class="flex items-center gap-3">
            <%= link_to "Cancelar",
                        investments_transactions_path,
                        class: "rounded-full border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50" %>

            <%= f.button :submit,
                         class: "rounded-full bg-blue-700 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" %>
          </div>
        </div>

      <% end %>
    </div>
  </div>
</div>
