<div class="mx-auto w-full max-w-5xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <%= render ButtonComponent.new(label: "Voltar para movimentações", href: investments_transactions_path, variant: :soft_olive, icon: "fa-solid fa-arrow-left") %>
    <p class="mt-6 text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Investimentos</p>
    <h1 class="mt-3 text-3xl font-semibold text-slate-950"><%= @transaction.persisted? ? "Editar movimentação" : "Nova movimentação" %></h1>
    <p class="mt-2 max-w-xl text-sm leading-6 text-slate-600">Registre compras, vendas, transferências e demais eventos dos seus investimentos.</p>

    <%= form_with model: @transaction, local: true do |f| %>
      <%= render "form_fields", f: f %>

      <div class="mt-6 flex flex-col gap-4 border-t border-slate-200 pt-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm leading-6 text-slate-500">As movimentações serão utilizadas para cálculo de posição e preço médio.</p>
        <div class="flex items-center gap-3">
          <%= render ButtonComponent.new(label: "Cancelar", href: investments_transactions_path, variant: :soft_olive) %>
          <%= f.button :submit, class: ButtonComponent::VARIANT_STYLES[:primary] do %>
            <i class="fa-solid fa-floppy-disk"></i>
            <%= @transaction.persisted? ? "Salvar alterações" : "Criar movimentação" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>
</div>
