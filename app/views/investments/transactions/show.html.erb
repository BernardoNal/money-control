<div class="mx-auto w-full max-w-5xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <%= render ButtonComponent.new(
              label: "Voltar para movimentações",
              href: investments_transactions_path,
              variant: :soft_olive,
              icon: "fa-solid fa-arrow-left"
            ) %>

        <p class="mt-6 text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">
          Movimentação
        </p>

        <h1 class="mt-3 text-3xl font-semibold text-slate-950">
          <%= @transaction.asset.symbol %>
        </h1>

        <h3 class="mt-2 font-semibold text-slate-400">
          <%= @transaction.asset.name %>
        </h3>

        <p class="mt-2 text-3xl font-semibold <%= @transaction.transaction_type == "sell" ? "text-rose-600" : "text-emerald-600" %>">
          <% if @transaction.price.present? %>
            <%= number_to_currency(
                  @transaction.price * @transaction.quantity,
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          <% else %>
            —
          <% end %>
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= render ButtonComponent.new(
              label: "Editar",
              href: edit_investments_transaction_path(@transaction),
              variant: :primary,
              icon: "fa-solid fa-pen-to-square"
            ) %>

        <%= render ButtonComponent.new(
              label: "Apagar",
              href: investments_transaction_path(@transaction),
              variant: :danger,
              icon: "fa-solid fa-trash",
              data: {
                turbo_method: :delete,
                turbo_confirm: "Tem certeza que deseja excluir esta movimentação?"
              }
            ) %>
      </div>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Data</p>
        <p class="mt-2 text-lg font-semibold text-slate-950">
          <%= l(@transaction.date) %>
        </p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Carteira</p>
        <p class="mt-2 text-lg font-semibold text-slate-950">
          <%= @transaction.portfolio.name %>
        </p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Tipo</p>
        <p class="mt-2 text-lg font-semibold <%= @transaction.transaction_type == "sell" ? "text-rose-600" : "text-emerald-600" %>">
          <%= t(
                "activerecord.attributes.investments/transaction.transaction_types.#{@transaction.transaction_type}"
              ) %>
        </p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Quantidade</p>
        <p class="mt-2 text-lg font-semibold text-slate-950">
          <%= number_with_precision(
                @transaction.quantity,
                precision: 8,
                strip_insignificant_zeros: true
              ) %>
        </p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Preço por ativo</p>
        <p class="mt-2 text-lg font-semibold text-slate-950">
          <% if @transaction.price.present? %>
            <%= number_to_currency(
                  @transaction.price,
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          <% else %>
            —
          <% end %>
        </p>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Taxas</p>
        <p class="mt-2 text-lg font-semibold text-slate-950">
          <% if @transaction.fees.present? && @transaction.fees != 0 %>
            <%= number_to_currency(
                  @transaction.fees,
                  unit: "R$ ",
                  separator: ",",
                  delimiter: "."
                ) %>
          <% else %>
            —
          <% end %>
        </p>
      </div>
    </div>

    <% if @transaction.notes.present? %>
      <div class="mt-8 rounded-3xl border border-slate-200 bg-slate-50 p-5">
        <p class="text-sm text-slate-500">Observações</p>

        <p class="mt-2 whitespace-pre-line text-base leading-6 text-slate-700">
          <%= @transaction.notes %>
        </p>
      </div>
    <% end %>
  </section>
</div>
