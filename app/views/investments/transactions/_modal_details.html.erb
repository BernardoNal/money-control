<div>
  <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Movimentação</p>
  <h3 class="mt-2 text-2xl font-semibold text-slate-950"><%= transaction.asset.symbol %></h3>
  <p class="mt-1 text-slate-500"><%= transaction.asset.name %></p>
  <p class="mt-3 text-3xl font-semibold <%= transaction.transaction_type == "sell" ? "text-rose-600" : "text-emerald-600" %>">
    <% if transaction.price.present? %>
      <%= privacy_value(number_to_currency(transaction.price * transaction.quantity, unit: "R$ ", separator: ",", delimiter: ".")) %>
    <% else %>
      —
    <% end %>
  </p>
</div>

<div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  <% [
    ["Data", l(transaction.date), "text-slate-950"],
    ["Carteira", transaction.portfolio.name, "text-slate-950"],
    ["Tipo", t("activerecord.attributes.investments/transaction.transaction_types.#{transaction.transaction_type}"), transaction.transaction_type == "sell" ? "text-rose-600" : "text-emerald-600"],
    ["Quantidade", privacy_value(number_with_precision(transaction.quantity, precision: 8, strip_insignificant_zeros: true)), "text-slate-950"],
    ["Preço por ativo", transaction.price.present? ? privacy_value(number_to_currency(transaction.price, unit: "R$ ", separator: ",", delimiter: ".")) : "—", "text-slate-950"],
    ["Taxas", transaction.fees.present? && transaction.fees != 0 ? privacy_value(number_to_currency(transaction.fees, unit: "R$ ", separator: ",", delimiter: ".")) : "—", "text-slate-950"]
  ].each do |label, value, color| %>
    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5">
      <p class="text-sm text-slate-500"><%= label %></p>
      <p class="mt-2 text-lg font-semibold <%= color %>"><%= value %></p>
    </div>
  <% end %>
</div>

<% if transaction.notes.present? %>
  <div class="mt-8 rounded-3xl border border-slate-200 bg-slate-50 p-5">
    <p class="text-sm text-slate-500">Observações</p>
    <p class="mt-2 whitespace-pre-line text-base leading-6 text-slate-700"><%= transaction.notes %></p>
  </div>
<% end %>

<div class="mt-6 flex flex-wrap justify-end gap-3 border-t border-slate-200 pt-5">
  <%= render ButtonComponent.new(label: "Editar", href: edit_investments_transaction_path(transaction), variant: :primary, icon: "fa-solid fa-pen-to-square") %>
  <%= render ButtonComponent.new(label: "Apagar", href: investments_transaction_path(transaction), variant: :danger, icon: "fa-solid fa-trash", data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir esta movimentação?" }) %>
</div>
