<% if f.object.errors.any? %>
  <div class="mt-6 rounded-2xl border border-rose-300 bg-rose-50 p-4 text-rose-700">
    <p class="font-semibold">Não foi possível salvar a movimentação:</p>
    <ul class="mt-2 list-disc pl-5 text-sm">
      <% f.object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">
  <div>
    <%= f.label :portfolio_id, t("activerecord.attributes.investments/transaction.portfolio"), class: "mb-2 block text-sm font-medium text-slate-900" %>
    <%= f.select :portfolio_id, options_from_collection_for_select(@portfolios, :id, :name, f.object.portfolio_id), { prompt: "Selecione uma carteira" }, class: "block w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
  </div>

  <div>
    <%= render Investments::SearchableSelectComponent.new(
          form: f,
          attribute: :asset_id,
          selected: f.object.asset,
          selected_label: f.object.asset && "#{f.object.asset.symbol} - #{f.object.asset.name}",
          search_url: search_investments_assets_path,
          search_params: { active_only: true },
          label: t("activerecord.attributes.investments/transaction.asset")
        ) %>
  </div>

  <div>
    <%= f.label :transaction_type, t("activerecord.attributes.investments/transaction.transaction_type"), class: "mb-2 block text-sm font-medium text-slate-900" %>
    <%= f.select :transaction_type, options_for_select(@transaction_types, f.object.transaction_type), { prompt: "Selecione um tipo" }, class: "block w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
  </div>

  <div>
    <%= f.label :date, t("activerecord.attributes.investments/transaction.date"), class: "mb-2 block text-sm font-medium text-slate-900" %>
    <%= f.date_field :date, class: "block w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
  </div>
</div>

<div class="mt-6 grid grid-cols-1 gap-5 border-t border-slate-200 pt-6 md:grid-cols-3">
  <div>
    <%= f.label :quantity, t("activerecord.attributes.investments/transaction.quantity"), class: "mb-2 block text-sm font-medium text-slate-900" %>
    <%= f.number_field :quantity, step: :any, min: 0, class: "block w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
  </div>
  <div>
    <%= f.label :price, t("activerecord.attributes.investments/transaction.price"), class: "mb-2 block text-sm font-medium text-slate-900" %>
    <%= f.number_field :price, step: :any, min: 0, class: "block w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
  </div>
  <div>
    <%= f.label :fees, t("activerecord.attributes.investments/transaction.fees"), class: "mb-2 block text-sm font-medium text-slate-900" %>
    <%= f.number_field :fees, step: :any, min: 0, class: "block w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
  </div>
</div>

<div class="mt-6 border-t border-slate-200 pt-4">
  <div class="mb-5"><h2 class="text-base font-semibold text-slate-950">Observações</h2></div>
  <%= f.text_area :notes, rows: 4, class: "block w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100", placeholder: "Observações opcionais..." %>
</div>
