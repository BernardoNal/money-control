<div class="mx-auto w-full max-w-7xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">
          Investimentos
        </p>

        <h1 class="mt-3 text-3xl font-semibold text-slate-950">
          Movimentações recentes
        </h1>

        <p class="mt-2 text-sm leading-6 text-slate-600">
          Consulte as últimas compras, vendas e demais movimentações registradas.
        </p>
      </div>

      <%= render ButtonComponent.new(
            label: "Nova movimentação",
            href: new_investments_transaction_path,
            variant: :primary,
            icon: "fa-solid fa-circle-plus"
          ) %>
    </div>

    <% if @transactions.any? %>
      <div class="mt-8 overflow-x-auto rounded-3xl border border-slate-200">
        <table class="min-w-full text-left text-sm">
          <thead class="bg-slate-100 text-slate-600">
            <tr>
              <th class="px-5 py-4 font-semibold">Data</th>
              <th class="px-5 py-4 font-semibold">Carteira</th>
              <th class="px-5 py-4 font-semibold">Ativo</th>
              <th class="px-5 py-4 font-semibold">Tipo</th>
              <th class="px-5 py-4 text-right font-semibold">Quantidade</th>
              <th class="px-5 py-4 text-right font-semibold">Preço</th>
              <th class="px-5 py-4 text-right font-semibold">Taxas</th>
              <th class="px-5 py-4 text-right font-semibold">Total</th>
              <th class="px-5 py-4 text-right font-semibold">Ações</th>
            </tr>
          </thead>

          <tbody class="bg-white">
            <% @transactions.each do |transaction| %>
              <tr class="border-t border-slate-200">
                <td class="px-5 py-4 text-slate-700">
                  <%= l(transaction.date) %>
                </td>

                <td class="px-5 py-4 text-slate-700">
                  <%= transaction.portfolio.name %>
                </td>

                <td class="px-5 py-4 font-medium text-slate-900">
                  <%= transaction.asset.symbol %>
                </td>

                <td class="px-5 py-4 text-slate-700">
                  <span class="<%= transaction.transaction_type == "sell" ? 'text-rose-600' : 'text-emerald-600' %> font-semibold">
                    <%= t(
                      "activerecord.attributes.investments/transaction.transaction_types.#{transaction.transaction_type}"
                    ) %>
                  </span>
                </td>

                <td class="px-5 py-4 text-right text-slate-700">
                  <%= number_with_precision(
                        transaction.quantity,
                        precision: 8,
                        strip_insignificant_zeros: true
                      ) %>

                </td>

                <td class="px-5 py-4 text-right text-slate-700">
                  <% if transaction.price.present? %>
                    <%= number_to_currency(transaction.price, unit: "R$ ", separator: ",", delimiter: ".") %>
                  <% else %>
                    —
                  <% end %>
                </td>

                <td class="px-5 py-4 text-right text-slate-700">
                   <% if transaction.fees.to_d.nonzero? %>
                    <%= number_to_currency(transaction.fees, unit: "R$ ", separator: ",", delimiter: ".") %>
                  <% else %>
                    —
                  <% end %>
                </td>

                <td class="px-5 py-4 text-right text-slate-700">
                  <% if transaction.price.present? %>
                    <%= number_to_currency((transaction.price * transaction.quantity), unit: "R$ ", separator: ",", delimiter: ".") %>
                  <% else %>
                    —
                  <% end %>
                </td>

                <td class="px-5 py-4">
                  <div class="flex items-center justify-end gap-3">
                    <%= link_to investments_transaction_path(transaction),
                                class: "text-slate-500 transition hover:text-slate-900",
                                title: "Visualizar" do %>
                      <i class="fa-solid fa-eye"></i>
                    <% end %>

                    <%= link_to edit_investments_transaction_path(transaction),
                                class: "text-emerald-600 transition hover:text-emerald-700",
                                title: "Editar" do %>
                      <i class="fa-solid fa-pen-to-square"></i>
                    <% end %>

                    <%= link_to investments_transaction_path(transaction),
                                data: {
                                  turbo_method: :delete,
                                  turbo_confirm: "Tem certeza que deseja excluir esta movimentação?"
                                },
                                class: "text-rose-600 transition hover:text-rose-700",
                                title: "Excluir" do %>
                      <i class="fa-solid fa-trash"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="mt-8 rounded-3xl border border-slate-200 px-8 py-16 text-center">
        <i class="fa-solid fa-chart-line text-4xl text-slate-300"></i>

        <h2 class="mt-4 text-lg font-medium text-slate-900">
          Nenhuma movimentação encontrada
        </h2>

        <p class="mt-2 text-sm text-slate-500">
          Comece registrando sua primeira compra, venda ou transferência.
        </p>

        <%= render ButtonComponent.new(
              label: "Nova movimentação",
              href: new_investments_transaction_path,
              variant: :primary,
              icon: "fa-solid fa-circle-plus"
            ) %>
      </div>
    <% end %>
  </section>
</div>
