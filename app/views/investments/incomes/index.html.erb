<div class="container mt-8 max-w-7xl">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">
        Investments
      </p>

      <h1 class="mt-2 text-3xl font-semibold text-gray-900">
        Proventos
      </h1>

      <p class="mt-2 text-sm text-gray-600">
        Histórico de rendimentos recebidos.
      </p>
    </div>

    <%= link_to new_investments_income_path,
                class: "inline-flex items-center gap-2 rounded-full bg-blue-700 px-4 py-2 text-sm font-medium text-white text-decoration-none transition hover:bg-blue-800" do %>
      <i class="fa-solid fa-circle-plus"></i>
      Novo provento
    <% end %>
  </div>

  <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @incomes.each do |income| %>
      <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold text-gray-900">
              <%= income.asset.symbol %>
            </h2>

            <p class="mt-1 text-sm text-gray-600">
              <%= income.income_type.humanize %>
            </p>
          </div>

          <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-medium text-green-700">
            <%= number_to_currency(income.net_amount) %>
          </span>
        </div>

        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="text-gray-500">Portfolio</dt>
            <dd class="font-medium text-gray-900">
              <%= income.portfolio.name %>
            </dd>
          </div>

          <div class="flex justify-between gap-4">
            <dt class="text-gray-500">Pagamento</dt>
            <dd class="font-medium text-gray-900">
              <%= l(income.payment_date) %>
            </dd>
          </div>

          <div class="flex justify-between gap-4">
            <dt class="text-gray-500">Valor bruto</dt>
            <dd class="font-medium text-gray-900">
              <%= number_to_currency(income.gross_amount) %>
            </dd>
          </div>
        </dl>

        <div class="mt-5">
          <%= link_to investments_income_path(income),
                      class: "inline-flex items-center px-3 py-2 text-center text-white bg-blue-600 rounded-lg hover:bg-blue-800" do %>
            Ver mais&nbsp;<i class="fa-solid fa-arrow-right"></i>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @incomes.empty? %>
    <div class="mt-6 rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-6 text-center text-gray-600">
      Nenhum provento cadastrado.
    </div>
  <% end %>
</div>
