<% current_tab = %w[overview list].include?(params[:tab]) ? params[:tab] : "overview" %>
<% tab_params = request.query_parameters.except("set") %>
<% income_period_label = { "year" => "Este ano", "30d" => "Últimos 30 dias", "all" => "Todo o período" }.fetch(@income_period) %>
<div class="mx-auto w-full max-w-7xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Investimentos</p>
        <h1 class="mt-3 text-3xl font-semibold text-slate-950">Proventos</h1>
        <p class="mt-2 text-sm leading-6 text-slate-600">Histórico de rendimentos recebidos.</p>
      </div>

      <%= render ButtonComponent.new(label: "Novo provento", href: new_investments_income_path, variant: :primary, icon: "fa-solid fa-circle-plus") %>
    </div>

    <nav class="mt-8 flex flex-wrap gap-3" aria-label="Seções de proventos">
      <%= link_to investments_incomes_path(tab_params.merge(tab: "overview")),
                  class: "inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-semibold transition #{current_tab == "overview" ? "border-[#000080] bg-[#000080] text-white shadow-sm" : "border-slate-300 bg-white text-slate-700 hover:border-slate-400 hover:text-slate-950"}" do %>
        <i class="fa-solid fa-chart-pie" aria-hidden="true"></i>
        Visão geral
      <% end %>

      <%= link_to investments_incomes_path(tab_params.merge(tab: "list")),
                  class: "inline-flex items-center gap-2 rounded-full border px-5 py-2.5 text-sm font-semibold transition #{current_tab == "list" ? "border-[#000080] bg-[#000080] text-white shadow-sm" : "border-slate-300 bg-white text-slate-700 hover:border-slate-400 hover:text-slate-950"}" do %>
        <i class="fa-solid fa-list" aria-hidden="true"></i>
        Lista
      <% end %>
    </nav>

    <div class="rounded-3xl bg-slate-50 p-6">
      <%= form_with url: investments_incomes_path, method: :get, local: true, class: "grid gap-5 lg:grid-cols-[1fr_1fr_1fr_auto]" do |f| %>
        <%= hidden_field_tag :tab, current_tab %>

        <div>
          <%= f.label :income_type, "Tipo", class: "mb-1.5 block text-sm font-medium" %>
          <%= f.select :income_type,
                       options_for_select([["Todas", ""]] + @income_types, @selected_income_type),
                       {},
                       class: "w-full bg-white" %>
        </div>

        <div>
          <%= f.label :asset, "Ativos", class: "mb-1.5 block text-sm font-medium" %>
          <%= f.select :asset,
                       options_for_select([["Todos", ""]] + @assets, @selected_asset),
                       {},
                       class: "w-full bg-white" %>
        </div>

         <div>
          <%= f.label :portfolio, "Conta", class: "mb-1.5 block text-sm font-medium" %>
          <%= f.select :portfolio,
                       options_for_select([["Todos", ""]] + @portfolios, @selected_portfolio),
                       {},
                       class: "w-full bg-white" %>
        </div>

        <div class="flex flex-wrap items-end gap-3 lg:justify-end">
          <%= f.button class: ButtonComponent::VARIANT_STYLES[:primary] do %>
            <i class="fa-solid fa-magnifying-glass"></i>
            Aplicar filtro
          <% end %>
          <%= render ButtonComponent.new(label: "Limpar", href: investments_incomes_path(tab: current_tab), variant: :soft_olive, icon:"fa-solid fa-eraser") %>
        </div>
      <% end %>
    </div>

    <% if current_tab == "overview" %>
      <section class="mt-8" aria-labelledby="income-overview-title">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <h2 id="income-overview-title" class="text-xl font-semibold text-slate-950">Resumo dos proventos</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">Acompanhe o valor líquido recebido e sua distribuição por tipo.</p>
          </div>

          <div class="flex items-center gap-2" aria-label="Período do resumo">
            <%= link_to "Este ano",
                        investments_incomes_path(tab_params.merge(tab: "overview", income_period: "year")),
                        class: "inline-flex items-center rounded-full border px-4 py-2 text-sm font-semibold transition #{@income_period == "year" ? "border-[#000080] bg-[#000080] text-white" : "border-slate-300 bg-white text-slate-700 hover:border-slate-400"}" %>
            <%= link_to "Últimos 30 dias",
                        investments_incomes_path(tab_params.merge(tab: "overview", income_period: "30d")),
                        class: "inline-flex items-center rounded-full border px-4 py-2 text-sm font-semibold transition #{@income_period == "30d" ? "border-[#000080] bg-[#000080] text-white" : "border-slate-300 bg-white text-slate-700 hover:border-slate-400"}" %>
            <%= link_to "Todo o período",
                        investments_incomes_path(tab_params.merge(tab: "overview", income_period: "all")),
                        class: "inline-flex items-center rounded-full border px-4 py-2 text-sm font-semibold transition #{@income_period == "all" ? "border-[#000080] bg-[#000080] text-white" : "border-slate-300 bg-white text-slate-700 hover:border-slate-400"}" %>
          </div>
        </div>

        <div class="mt-5 grid gap-5 md:grid-cols-3">
          <div class="rounded-3xl border border-emerald-200 bg-emerald-50 p-5">
            <p class="text-sm font-medium text-emerald-700">Total recebido no período</p>
            <p class="mt-3 text-2xl font-semibold text-emerald-800"><%= number_to_currency(@income_analytics.total_net_amount, unit: "R$ ", separator: ",", delimiter: ".") %></p>
            <p class="mt-2 text-xs font-medium text-emerald-700">
              Valor líquido · <%= income_period_label %>
            </p>
          </div>

          <div class="rounded-3xl border border-slate-300 bg-slate-50 p-5">
            <p class="text-sm font-medium text-slate-500">Média por provento</p>
            <p class="mt-3 text-2xl font-semibold text-slate-950"><%= number_to_currency(@income_analytics.average_net_amount, unit: "R$ ", separator: ",", delimiter: ".") %></p>
            <p class="mt-2 text-xs font-medium text-slate-500">
              Baseada em <%= @income_analytics.income_count %> provento(s)
            </p>
          </div>

          <div class="rounded-3xl border border-blue-200 bg-blue-50 p-5">
            <p class="text-sm font-medium text-blue-700">Maior provento</p>
            <p class="mt-3 text-2xl font-semibold text-blue-900"><%= number_to_currency(@income_analytics.largest_net_amount, unit: "R$ ", separator: ",", delimiter: ".") %></p>
            <% if @income_analytics.largest_income.present? %>
              <p class="mt-2 text-xs font-medium text-blue-700">
                <%= @income_analytics.largest_income.asset.symbol %> ·
                <%= @income_analytics.largest_income.human_income_type %> ·
                <%= l(@income_analytics.largest_income.payment_date) %>
              </p>
            <% end %>
          </div>
        </div>

        <% chart_primary_color = "#2563eb" %>
        <% chart_secondary_colors = %w[#60a5fa #2dd4bf #5eead4 #86efac #cbd5e1] %>
        <% chart_total = @income_analytics.income_totals_by_type.values.sum(&:to_d) %>
        <% chart_entries = @income_types.each_with_index.filter_map do |(label, income_type), index| %>
          <% amount = @income_analytics.income_totals_by_type[income_type].to_d %>
          <% next if amount.zero? %>
          <% percentage = chart_total.zero? ? 0 : (amount / chart_total * 100) %>
          <% { label: label, amount: amount, percentage: percentage } %>
        <% end %>
        <% largest_chart_entry_index = chart_entries.each_index.max_by { |index| chart_entries[index][:amount] } %>
        <% secondary_color_index = 0 %>
        <% chart_entries.each_with_index do |entry, index| %>
          <% if index == largest_chart_entry_index %>
            <% entry[:color] = chart_primary_color %>
          <% else %>
            <% entry[:color] = chart_secondary_colors[secondary_color_index] || chart_secondary_colors.last %>
            <% secondary_color_index += 1 %>
          <% end %>
        <% end %>
        <% chart_cursor = 0.to_d %>
        <% chart_segments = chart_entries.map do |entry| %>
          <% start_percentage = chart_cursor %>
          <% chart_cursor += entry[:percentage] %>
          <% "#{entry[:color]} #{start_percentage.round(2)}% #{chart_cursor.round(2)}%" %>
        <% end %>

        <div class="mt-6 rounded-3xl border border-slate-300 bg-white p-5 lg:p-6">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h2 class="text-lg font-semibold text-slate-950">Histórico mensal</h2>
              <p class="mt-1 text-sm text-slate-500">Renda líquida recebida por mês com base na data de pagamento.</p>
            </div>

            <div class="flex items-center gap-2" aria-label="Tipo de gráfico histórico">
              <%= link_to "Barras",
                          investments_incomes_path(tab_params.merge(tab: "overview", income_period: @income_period, income_chart: "bar")),
                          class: "inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold transition #{@income_chart == "bar" ? "border-[#000080] bg-[#000080] text-white" : "border-slate-300 bg-white text-slate-700 hover:border-slate-400"}" %>
              <%= link_to "Linha",
                          investments_incomes_path(tab_params.merge(tab: "overview", income_period: @income_period, income_chart: "line")),
                          class: "inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold transition #{@income_chart == "line" ? "border-[#000080] bg-[#000080] text-white" : "border-slate-300 bg-white text-slate-700 hover:border-slate-400"}" %>
            </div>
          </div>

          <% if @income_analytics.monthly_income_history.any? %>
            <% max_monthly_amount = @income_analytics.monthly_income_history.map(&:amount).max || 0 %>
            <% if @income_chart == "line" %>
              <% chart_width = 720 %>
              <% chart_height = 260 %>
              <% chart_padding_left = 64 %>
              <% chart_padding_right = 20 %>
              <% chart_padding_top = 18 %>
              <% chart_padding_bottom = 42 %>
              <% chart_plot_width = chart_width - chart_padding_left - chart_padding_right %>
              <% chart_plot_height = chart_height - chart_padding_top - chart_padding_bottom %>
              <% chart_step = @income_analytics.monthly_income_history.length > 1 ? chart_plot_width.to_f / (@income_analytics.monthly_income_history.length - 1) : 0 %>
              <% chart_points = @income_analytics.monthly_income_history.each_with_index.map do |entry, index| %>
                <% x = chart_padding_left + (index * chart_step) %>
                <% y = max_monthly_amount.to_d.zero? ? chart_padding_top + (chart_plot_height / 2) : chart_padding_top + ((max_monthly_amount.to_d - entry.amount) / max_monthly_amount.to_d * chart_plot_height).to_f %>
                <% { entry: entry, x: x.round(2), y: y.round(2) } %>
              <% end %>

              <div class="mt-6 overflow-x-auto pb-2">
                <svg class="h-64 min-w-[38rem] w-full" viewBox="0 0 <%= chart_width %> <%= chart_height %>" role="img" aria-label="Histórico mensal de renda em linha">
                  <% [0, 0.25, 0.5, 0.75, 1].each do |reference_ratio| %>
                    <% reference_y = chart_padding_top + ((1 - reference_ratio) * chart_plot_height) %>
                    <line x1="<%= chart_padding_left %>" y1="<%= reference_y %>" x2="<%= chart_width - chart_padding_right %>" y2="<%= reference_y %>" stroke="#94a3b8" stroke-width="1.5" />
                    <text x="4" y="<%= reference_y + 4 %>" fill="#475569" font-size="10"><%= number_to_currency(max_monthly_amount.to_d * reference_ratio, unit: "R$ ", separator: ",", delimiter: ".") %></text>
                  <% end %>
                  <polyline points="<%= chart_points.map { |point| "#{point[:x]},#{point[:y]}" }.join(" ") %>" fill="none" stroke="#2563eb" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" />
                  <% chart_points.each do |point| %>
                    <% tooltip_width = 80 %>
                    <% tooltip_x = point[:x] > chart_width - tooltip_width - 24 ? point[:x] - tooltip_width - 8 : point[:x] + 8 %>
                    <% tooltip_text_x = tooltip_x + (tooltip_width / 2) %>
                    <line x1="<%= point[:x] %>" y1="<%= chart_padding_top %>" x2="<%= point[:x] %>" y2="<%= chart_padding_top + chart_plot_height %>" stroke="#e2e8f0" stroke-width="1.5" />
                    <g class="group">
                      <circle cx="<%= point[:x] %>" cy="<%= point[:y] %>" r="6" fill="#2563eb" stroke="white" stroke-width="2" aria-label="<%= point[:entry].month.strftime("%m/%Y") %>: <%= number_to_currency(point[:entry].amount, unit: "R$ ", separator: ",", delimiter: ".") %>" />
                      <g class="pointer-events-none opacity-0 transition-opacity group-hover:opacity-100">
                        <rect x="<%= tooltip_x %>" y="<%= [point[:y] - 34, 2].max %>" width="<%= tooltip_width %>" height="26" rx="6" fill="#ffffff" stroke="#2563eb" stroke-width="1" />
                        <text x="<%= tooltip_text_x %>" y="<%= [point[:y] - 17, 19].max %>" text-anchor="middle" fill="#0f172a" font-size="10" font-weight="600"><%= number_to_currency(point[:entry].amount, unit: "R$ ", separator: ",", delimiter: ".") %></text>
                      </g>
                    </g>
                    <text x="<%= point[:x] %>" y="<%= chart_height - 12 %>" text-anchor="middle" fill="#64748b" font-size="10"><%= point[:entry].month.strftime("%m/%y") %></text>
                  <% end %>
                </svg>
              </div>
            <% else %>
              <div class="mt-6 overflow-x-auto pb-2">
                <div class="flex h-64 min-w-[38rem] items-end gap-3">
                  <% @income_analytics.monthly_income_history.each do |entry| %>
                    <% height = max_monthly_amount.to_d.zero? ? 0 : ((entry.amount / max_monthly_amount.to_d) * 100).to_f %>
                    <div class="flex min-w-14 flex-1 flex-col items-center justify-end gap-2">
                      <span class="whitespace-nowrap text-xs font-medium text-slate-600"><%= number_to_currency(entry.amount, unit: "R$ ", separator: ",", delimiter: ".") %></span>
                      <div class="relative flex h-44 w-full items-end rounded-2xl bg-slate-100 bg-[linear-gradient(to_top,#e2e8f0_1px,transparent_1px)] bg-[size:100%_25%] px-2 py-2" title="<%= entry.month.strftime("%m/%Y") %>: <%= number_to_currency(entry.amount, unit: "R$ ", separator: ",", delimiter: ".") %>">
                        <div class="w-full rounded-xl bg-blue-500 transition-all" style="height: <%= [height.round(2), 100].min %>%"></div>
                      </div>
                      <span class="whitespace-nowrap text-xs font-medium text-slate-600"><%= entry.month.strftime("%m/%Y") %></span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center">
              <i class="fa-solid fa-chart-column text-2xl text-slate-300" aria-hidden="true"></i>
              <p class="mt-3 text-sm text-slate-600">Nenhum histórico mensal disponível no período selecionado.</p>
            </div>
          <% end %>
        </div>

        <div class="mt-6 grid gap-6 xl:grid-cols-[1.2fr_0.8fr]">
          <div class="rounded-3xl border border-slate-300 bg-white p-5 lg:p-6">
            <div>
              <h2 class="text-lg font-semibold text-slate-950">Distribuição por tipo</h2>
              <p class="mt-1 text-sm text-slate-500">Participação no total recebido no período.</p>
            </div>

            <% if chart_entries.any? %>
              <div class="mt-6 flex flex-col items-center gap-6 sm:flex-row sm:items-center">
                <div class="h-44 w-44 shrink-0 rounded-full" style="background: conic-gradient(<%= chart_segments.join(", ") %>);" role="img" aria-label="Distribuição dos proventos por tipo"></div>
                <ul class="w-full space-y-3 text-sm">
                  <% chart_entries.each do |entry| %>
                    <li class="flex items-center justify-between gap-3">
                      <span class="flex items-center gap-2 text-slate-700">
                        <span class="h-3 w-3 rounded-full" style="background-color: <%= entry[:color] %>" aria-hidden="true"></span>
                        <%= entry[:label] %>
                      </span>
                      <span class="text-right font-semibold text-slate-950">
                        <%= number_to_currency(entry[:amount], unit: "R$ ", separator: ",", delimiter: ".") %>
                        <span class="ml-1 text-xs font-medium text-slate-500">(<%= number_with_precision(entry[:percentage], precision: 1) %>%)</span>
                      </span>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% else %>
              <p class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-sm text-slate-600">Nenhum recebimento no período selecionado.</p>
            <% end %>
          </div>

          <div class="rounded-3xl border border-slate-300 bg-white p-5 lg:p-6">
            <div class="flex items-center justify-between gap-4">
              <div>
                <h2 class="text-lg font-semibold text-slate-950">Últimos 3 proventos</h2>
                <p class="mt-1 text-sm text-slate-500">Recebimentos mais recentes no período.</p>
              </div>
              <i class="fa-solid fa-clock-rotate-left text-slate-400" aria-hidden="true"></i>
            </div>

            <% if @income_analytics.latest_incomes.any? %>
              <div class="mt-5 divide-y divide-slate-200">
                <% @income_analytics.latest_incomes.each do |income| %>
                  <div class="flex items-center justify-between gap-4 py-3 first:pt-0 last:pb-0">
                    <div>
                      <p class="font-semibold text-slate-950"><%= income.asset.symbol %></p>
                      <p class="mt-1 text-sm text-slate-500"><%= income.human_income_type %> · <%= l(income.payment_date) %></p>
                    </div>
                    <p class="whitespace-nowrap font-semibold text-emerald-700"><%= number_to_currency(income.net_amount, unit: "R$ ", separator: ",", delimiter: ".") %></p>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-sm text-slate-600">Nenhum provento no período selecionado.</p>
            <% end %>
          </div>
        </div>

      </section>
    <% else %>
      <p class="mt-2 text-sm leading-6 text-slate-500"><%= @incomes.count %> proventos encontrados</p>
    <% if @incomes.any? %>
      <div class="mt-4 overflow-x-auto rounded-3xl border border-slate-700">
        <table class="min-w-full text-left text-base">
          <thead class="bg-slate-700 text-slate-200">
            <tr>
              <th class="px-4 py-3 font-semibold">Ativo</th>
              <th class="px-4 py-4 font-semibold">Valor Líquido</th>
              <th class="px-4 py-4 font-semibold">Data</th>
              <th class="px-4 py-4 font-semibold">Conta</th>
              <th class="px-4 py-4 font-semibold text-right">Ações</th>
            </tr>
          </thead>
          <tbody class="bg-white">
            <% @visible_incomes.each do |income| %>
              <tr class="border-t border-slate-200 ">
                <td class="px-4 py-3">
                  <div class="font-semibold text-slate-950"><%= income.asset.symbol %></div>
                  <div class="mt-1 text-sm text-slate-600"><%= income.human_income_type %></div>
                </td>
                <td class="px-4 py-4">
                  <span class="<%= income.net_amount.negative? ? 'text-rose-600' : 'text-emerald-600' %> font-bold text-lg">
                    <%= number_to_currency(income.net_amount, unit: "R$ ", separator: ",", delimiter: ".") %>
                  </span>
                </td>
                <td class="px-4 py-4">
                  <div class="font-medium text-slate-900"><%= income.payment_date.strftime("%d/%m/%Y") %></div>
                </td>
                <td class="px-4 py-4">
                  <div class="font-medium text-slate-900"><%= income.portfolio.name %></div>
                </td>
                <td class="px-4 py-4">
                  <div class="flex items-center justify-end gap-3">
                    <%= link_to investments_income_path(income),  class: "text-lg text-slate-500 transition hover:text-slate-900" do %>
                    <i class="fa-solid fa-eye"></i>
                    <% end %>
                    <%= link_to edit_investments_income_path(income), class: "text-lg text-emerald-600 transition hover:text-emerald-700" do %>
                      <i class="fa-solid fa-pen-to-square"></i>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="mt-5 flex items-center justify-end gap-4 text-sm font-medium text-slate-600">
        <% if @offset > 0 %>
          <%= link_to investments_incomes_path(request.query_parameters.merge(set: @offset - @total_incomes)), class: "inline-flex items-center gap-2 rounded-full border border-slate-300 px-3 py-2 text-slate-700 no-underline transition hover:bg-slate-100 hover:text-slate-900" do %>
            <i class="fa-solid fa-arrow-left"></i>
            Anterior
          <% end %>
        <% end %>

        <span>Pagina <%= (@offset / @total_incomes) + 1 %></span>

        <% if @offset + @total_incomes < @incomes.count %>
          <%= link_to investments_incomes_path(request.query_parameters.merge(set: @offset + @total_incomes)), class: "inline-flex items-center gap-2 rounded-full border border-slate-300 px-3 py-2 text-slate-700 no-underline transition hover:bg-slate-100 hover:text-slate-900" do %>
            Proxima
            <i class="fa-solid fa-arrow-right"></i>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="mt-8 rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center">
        <h2 class="text-xl font-semibold text-slate-950">Nenhum provento encontrado</h2>
        <p class="mt-2 text-sm text-slate-600">Ajuste os filtros ou cadastre um novo provento.</p>
        <div class="mt-6 flex justify-center">
          <%= render ButtonComponent.new(label: "Novo provento", href: new_investments_income_path, variant: :primary, icon: "fa-solid fa-circle-plus") %>
        </div>
      </div>
      <% end %>
    <% end %>
  </section>
</div>
