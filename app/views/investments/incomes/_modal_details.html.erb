<div class="flex flex-wrap items-center gap-3">
  <h3 class="text-3xl font-semibold text-slate-950"><%= income.asset.symbol %></h3>
  <span class="rounded-full bg-[#000080]/10 px-3 py-1 text-sm font-medium text-[#000080]"><%= income.human_income_type %></span>
</div>
<p class="mt-2 text-sm text-slate-600"><%= income.asset.name %> · <%= income.portfolio.name %></p>
<div class="mt-6 grid gap-5 md:grid-cols-3">
  <div class="rounded-2xl border border-emerald-300 bg-emerald-50 p-6"><p class="text-sm font-medium text-emerald-700">Valor Líquido</p><p class="mt-3 text-3xl font-bold text-emerald-700"><%= privacy_value(number_to_currency(income.net_amount, unit: "R$ ", separator: ",", delimiter: ".")) %></p></div>
  <div class="rounded-2xl border border-slate-300 bg-slate-50 p-6"><p class="text-sm font-medium text-slate-500">Valor Bruto</p><p class="mt-3 text-2xl font-semibold text-slate-900"><%= privacy_value(number_to_currency(income.gross_amount, unit: "R$ ", separator: ",", delimiter: ".")) %></p></div>
  <div class="rounded-2xl border border-red-300 bg-red-50 p-6"><p class="text-sm font-medium text-red-500">Imposto Retido</p><p class="mt-3 text-2xl font-semibold text-red-600"><%= privacy_value(number_to_currency(income.tax_amount, unit: "R$ ", separator: ",", delimiter: ".")) %></p></div>
</div>
<div class="mt-6 grid gap-5 md:grid-cols-2">
  <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5"><p class="text-sm text-slate-500">Data de Pagamento</p><p class="mt-2 text-lg font-semibold"><%= l(income.payment_date) %></p></div>
  <% if income.reference_date.present? %><div class="rounded-2xl border border-slate-200 bg-slate-50 p-5"><p class="text-sm text-slate-500">Data de Referência</p><p class="mt-2 text-lg font-semibold"><%= l(income.reference_date) %></p></div><% end %>
</div>
<% if income.notes.present? %><div class="mt-6 rounded-2xl border border-slate-300 bg-slate-50 p-5"><p class="text-sm text-slate-500">Observações</p><p class="mt-2 whitespace-pre-line text-slate-700"><%= income.notes %></p></div><% end %>
