<div class="mx-auto w-full max-w-6xl">
  <section class="overflow-hidden rounded-[2rem] border border-slate-300 bg-white shadow-sm">
    <div class="border-b border-slate-200 bg-gradient-to-r from-slate-50 to-white px-8 py-7">
      <%= render ButtonComponent.new(label: "Voltar", href: investments_incomes_path, variant: :soft_olive, icon: "fa-solid fa-arrow-left") %>
      <p class="mt-6 text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Investments</p>

      <h1 class="mt-3 text-3xl font-semibold text-slate-950">
        <%= @income.persisted? ? "Editar Provento" : "Novo Provento" %>
      </h1>

      <p class="mt-2 text-sm leading-6 text-slate-600">
        Cadastre dividendos, JCP e outros rendimentos recebidos.
      </p>
    </div>

    <div class="px-8 py-7">
      <%= form_with model: @income,
                    url: @income.persisted? ? investments_income_path(@income) : investments_incomes_path,
                    scope: :investments_income,
                    local: true do |f| %>

        <% if @income.errors.any? %>
          <div class="mb-6 rounded-2xl border border-red-300 bg-red-50 p-4 text-red-700">
            <p class="font-semibold">
              Não foi possível salvar o provento:
            </p>

            <ul class="mt-2 list-disc pl-5">
              <% @income.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid gap-5 md:grid-cols-3">
          <div>
            <%= f.label :portfolio_id, "Portfólio", class: "mb-1.5 block text-sm font-medium" %>

            <%= f.select :portfolio_id,
                        options_for_select(@portfolios, @income.portfolio_id),
                        {include_blank: @income.persisted? ? false : "Selecione um portifólio"},
                        class: "w-full " %>
          </div>

          <div>
            <%= f.label :asset_id, "Ativo", class: "mb-1.5 block text-sm font-medium" %>

            <%= f.select :asset_id,
                        options_for_select(@assets, @income.asset_id),
                        {include_blank: @income.persisted? ? false : "Selecione um ativo"},
                        class: "w-full " %>
          </div>

          <div>
            <%= f.label :income_type, "Tipo de Provento", class: "mb-1.5 block text-sm font-medium" %>

            <%= f.select :income_type,
                        options_for_select(@income_types, @income.human_income_type),
                        {include_blank: @income.persisted? ? false : "Selecione o tipo"},
                        class: "w-full " %>
          </div>

          <div>
            <%= f.label :gross_amount, "Valor Bruto", class: "mb-1.5 block text-sm font-medium" %>

            <%= f.number_field :gross_amount,
                              step: 0.0001,
                              class: "w-full",
                              required: true %>
          </div>


          <div>
            <%= f.label :tax_amount, "Imposto retido", class: "mb-1.5 block text-sm font-medium" %>

            <%= f.number_field :tax_amount,
                              step: 0.0001,
                              class: "w-full" %>
          </div>

          <div>
            <%= f.label :payment_date, "Data de Pagamento", class: "mb-1.5 block text-sm font-medium" %>

            <%= f.date_field :payment_date,
                            class: "w-full",
                            required: true %>
          </div>

          <div class="mt-4 md:col-span-3">
            <%= f.label :notes, "Observações", class: "mb-1.5 block text-sm font-medium" %>

            <%= f.text_area :notes,
                            rows: 4,
                            class: "w-full" %>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap justify-end gap-3">
          <%= f.button :submit, class: ButtonComponent::VARIANT_STYLES[:primary] %>
          <%= render ButtonComponent.new(label: "Cancelar", href: investments_incomes_path, variant: :soft_olive) %>
        </div>
      <% end %>
    </div>
  </section>
</div>
