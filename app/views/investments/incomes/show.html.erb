<div class="mx-auto w-full max-w-6xl">
  <section class="overflow-hidden rounded-[2rem] border border-slate-300 bg-white shadow-sm">
    <div class="border-b border-slate-200 bg-gradient-to-r from-slate-50 to-white px-8 py-6">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <%= render ButtonComponent.new(
              label: "Voltar",
              href: investments_incomes_path,
              variant: :soft_olive,
              icon: "fa-solid fa-arrow-left"
            ) %>

          <p class="mt-6 text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">
            Investimentos
          </p>

          <div class="mt-3 flex flex-wrap items-center gap-3">
            <h1 class="text-3xl font-semibold text-slate-950">
              <%= @income.asset.symbol %>
            </h1>

            <span class="rounded-full bg-[#000080]/10 px-3 py-1 text-sm font-medium text-[#000080]">
              <%= @income.human_income_type %>
            </span>
          </div>

            <dd class="mt-2 font-semibold text-slate-400">
                  <%= @income.portfolio.name %>
                </dd>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Visualize todas as informações deste provento.
          </p>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
        <%= render ButtonComponent.new(
              label: "Editar",
              href: edit_investments_income_path(@income),
              icon: "fa-solid fa-pen"
            ) %>

        <%= button_to investments_income_path(@income),
              method: :delete,
              form: {
                data: {
                  turbo_confirm: "Tem certeza que deseja remover este provento?"
                }
              },
              class: "inline-flex items-center justify-center gap-2 rounded-full bg-red-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-red-700" do %>
          <i class="fa-solid fa-trash"></i>
          Excluir
        <% end %>
      </div>

      </div>
    </div>



    <div class="px-8 py-6">

      <!-- Valores -->
      <section class="">
        <h2 class="mb-5 text-lg font-semibold text-slate-900">
          Valores
        </h2>

        <div class="grid gap-5 md:grid-cols-3">

          <div class="rounded-2xl border border-emerald-300 bg-emerald-50 p-6">
            <p class="text-sm font-medium text-emerald-700">
              Valor Líquido
            </p>

            <p class="mt-3 text-3xl font-bold text-emerald-700">
              <%= number_to_currency(@income.net_amount, unit: "R$ ", separator: ",", delimiter: ".") %>
            </p>
          </div>

          <div class="rounded-2xl border border-slate-300 bg-slate-50 p-6">
            <p class="text-sm font-medium text-slate-500">
              Valor Bruto
            </p>

            <p class="mt-3 text-2xl font-semibold text-slate-900">
              <%= number_to_currency(@income.gross_amount, unit: "R$ ", separator: ",", delimiter: ".") %>
            </p>
          </div>

          <div class="rounded-2xl border border-red-300 bg-red-50 p-6">
            <p class="text-sm font-medium text-red-500">
              Imposto Retido
            </p>

            <p class="mt-3 text-2xl font-semibold text-red-600">
              <%= number_to_currency(@income.tax_amount, unit: "R$ ", separator: ",", delimiter: ".") %>
            </p>
          </div>

        </div>
      </section>

      <!-- Datas -->
      <section class="mt-6">
        <h2 class="mb-5 text-lg font-semibold text-slate-900">
          Datas
        </h2>

        <div class="grid gap-5 md:grid-cols-2">

          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
            <p class="text-sm font-medium text-slate-500">
              Data de Pagamento
            </p>

            <p class="mt-2 text-lg font-semibold text-slate-900">
              <%= l(@income.payment_date) %>
            </p>
          </div>

          <% if @income.reference_date.present? %>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
              <p class="text-sm font-medium text-slate-500">
                Data de Referência
              </p>

              <p class="mt-2 text-lg font-semibold text-slate-900">
                <%= l(@income.reference_date) %>
              </p>
            </div>
          <% end %>

        </div>
      </section>

      <% if @income.notes.present? %>
        <section class="mt-6">
          <h2 class="mb-5 text-lg font-semibold text-slate-900">
            Observações
          </h2>

          <div class="rounded-2xl border border-slate-300 bg-slate-50 p-5">
            <p class="leading-7 text-slate-700">
              <%= @income.notes %>
            </p>
          </div>
        </section>
      <% end %>

    </div>
  </section>
</div>
