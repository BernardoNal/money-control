<div class="container mt-8 max-w-7xl">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Investments</p>
      <h1 class="mt-2 text-3xl font-semibold text-gray-900">Ativos</h1>
      <p class="mt-2 text-sm text-gray-600">Catalogo global de ativos com filtro por categoria.</p>
    </div>

    <%= link_to new_investments_asset_path, class: "inline-flex items-center gap-2 rounded-full bg-blue-700 px-4 py-2 text-sm font-medium text-white text-decoration-none transition hover:bg-blue-800" do %>
      <i class="fa-solid fa-circle-plus"></i>Novo ativo
    <% end %>
  </div>

  <div class="mt-6 rounded-3xl border border-gray-200 bg-white p-5 shadow-sm lg:p-6">
    <%= form_with url: investments_assets_path, method: :get, local: true, class: "grid gap-4 md:grid-cols-[minmax(0,280px)_auto]" do |f| %>
       <div class="flex  gap-4">
        <div>

        <%= f.label :category, "Categoria", class: "mb-2 block text-sm font-medium text-gray-900" %>
        <%= f.select :category,
                     options_for_select([["Todas", ""]] + @categories, @selected_category),
                     {},
                     class: "block  rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
        </div>
        <div>

        <%= f.label :category, "Ramo", class: "mb-2 block text-sm font-medium text-gray-900" %>
        <%= f.select :subcategory,
                     options_for_select([["Todos", ""]] + @subcategories, @selected_subcategory),
                     {},
                     class: "block rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100" %>
        </div>
        <div class="flex items-end gap-4">
          <%= f.button "Aplicar filtro", class: "rounded-full bg-gray-900 px-5 py-0 text-sm font-medium text-white transition hover:bg-gray-700" %>
          <%= link_to "Limpar", investments_assets_path, class: "rounded-full border border-gray-300 px-4 py-2.5 text-sm font-medium text-gray-700 transition hover:bg-gray-50" %>
        </div>
      </div>

    <% end %>
  </div>

  <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    <% @assets.each do |asset| %>
      <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class="text-xl font-semibold text-gray-900"><%= asset.symbol %></h2>
            <p class="mt-1 text-sm text-gray-600"><%= asset.name %></p>
          </div>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium uppercase tracking-wide text-slate-700"><%= asset.category.humanize %></span>
        </div>

        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="text-gray-500">Moeda</dt>
            <dd class="font-medium text-gray-900"><%= asset.currency %></dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-gray-500">Ramo</dt>
            <dd class="font-medium text-gray-900"><%= asset.human_subcategory %></dd>
          </div>
        </dl>

        <div class="mt-5">
          <%= link_to investments_asset_path(asset), class: "inline-flex items-center px-3 py-2 text-center text-white bg-blue-600 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300" do %>
            Ver mais&nbsp;<i class="fa-solid fa-arrow-right"></i>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @assets.empty? %>
    <div class="mt-6 rounded-2xl border border-dashed border-gray-300 bg-gray-50 p-6 text-center text-gray-600">
      Nenhum ativo encontrado para o filtro selecionado.
    </div>
  <% end %>
</div>
