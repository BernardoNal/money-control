<div class="container mx-auto w-full max-w-6xl">

  <div class="mt-6 rounded-3xl border border-gray-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
      <div>
        <%= render ButtonComponent.new(label: "Voltar para Ativos", href: investments_assets_path, variant: :soft_olive, icon: "fa-solid fa-arrow-left") %>
        <p class="mt-6 text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Investments Asset</p>
        <h1 class="mt-2 text-3xl font-semibold text-gray-900"><%= @asset.symbol %></h1>
        <p class="mt-2 text-sm text-gray-600"><%= @asset.name %></p>
      </div>


    </div>

    <dl class="mt-6 grid gap-4 md:grid-cols-3">
      <div class="rounded-2xl border border-gray-200 bg-slate-50 p-4">
        <dt class="text-sm text-gray-500">Categoria</dt>
        <dd class="mt-2 text-lg font-semibold text-gray-900"><%= @asset.human_category %></dd>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-slate-50 p-4">
        <dt class="text-sm text-gray-500">SubCategoria</dt>
        <dd class="mt-2 text-lg font-semibold text-gray-900"><%= @asset.human_subcategory  %></dd>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-slate-50 p-4">
        <dt class="text-sm text-gray-500">Moeda</dt>
        <dd class="mt-2 text-lg font-semibold text-gray-900"><%= @asset.currency %></dd>
      </div>
      <div class="rounded-2xl border border-gray-200 bg-slate-50 p-4">
        <dt class="text-sm text-gray-500">Status</dt>
        <dd class="mt-2 text-lg font-semibold <%= @asset.active? ? 'text-green-700' : 'text-red-700' %>"><%= @asset.active? ? "Ativo" : "Inativo" %></dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap gap-3">
      <%= link_to edit_investments_asset_path(@asset) do %>
        <%= render ButtonComponent.new(label: "Edit") %>
      <% end %>
    </div>
  </div>
</div>
