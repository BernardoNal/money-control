<% subcategory_map = Investments::Asset::CATEGORY_SUBCATEGORY_MAP.transform_values do |keys| %>
  <% keys.map { |key| [I18n.t("activerecord.attributes.investments/asset.subcategories.#{key}"), key] } %>
<% end %>

<div class="mx-auto w-full max-w-6xl">
  <section class="overflow-hidden rounded-[2rem] border border-slate-300 bg-white shadow-sm">
    <div class="border-b border-slate-200 bg-gradient-to-r from-slate-50 to-white px-8 py-8">
      <%= render ButtonComponent.new(label: "Voltar para ativos", href: investments_assets_path, variant: :soft_olive, icon: "fa-solid fa-arrow-left") %>
      <p class="mt-6 text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Investimentos</p>
      <h1 class="mt-3 text-3xl font-semibold text-slate-950"><%= @asset.persisted? ? "Editar ativo" : "Novo ativo" %></h1>
      <p class="mt-2 text-sm leading-6 text-slate-600">Cadastre ativos com categoria, moeda e status para uso no dominio de investimentos.</p>
      <% unless @asset.persisted? %>
        <div class="mt-4 rounded-3xl border border-blue-200 bg-blue-50 px-5 py-4">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700">Preenchimento automatico</p>
          <p class="mt-2 text-sm leading-6 text-blue-900">Voce pode informar apenas o ticker para tentar o preenchimento automatico, ou continuar com o cadastro manual.</p>
        </div>
      <% end %>
    </div>

    <div class="px-8 py-8">
      <%= form_with model: @asset, url: @asset.persisted? ? investments_asset_path(@asset) : investments_assets_path, scope: :investments_asset, local: true do |f| %>
        <% if @asset.errors.any? %>
          <div class="mb-6 rounded-2xl border border-red-300 bg-red-50 p-4 text-red-700">
            <p class="font-semibold">Nao foi possivel salvar o ativo:</p>
            <ul class="mt-2 list-disc pl-5">
              <% @asset.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid gap-5 md:grid-cols-2">
          <div>
            <%= f.label :symbol, "Ticker / Simbolo", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.text_field :symbol, class: "w-full", required: true %>
          </div>

          <div>
            <%= f.label :name, "Nome", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.text_field :name, class: "w-full" %>
          </div>

          <div>
            <%= f.label :category, "Categoria", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.select :category,
                         options_for_select(@categories, @asset.category),
                         { include_blank: @asset.persisted? ? false : "Selecione uma categoria" },
                         class: "w-full ",
                         data: { subcategory_map: json_escape(subcategory_map.to_json) } %>
          </div>

          <div>
            <%= f.label :subcategory, "Subcategoria", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.select :subcategory,
                         options_for_select(@subcategories, @asset.subcategory),
                         { include_blank: "Opcional" },
                         class: "w-full bg-white",
                         data: { role: "asset-subcategory-select" } %>
          </div>

          <div>
            <%= f.label :currency, "Moeda", class: "mb-1.5 block text-sm font-medium" %>
            <%= f.text_field :currency, class: "w-full", placeholder: "BRL, USD..." %>
          </div>
        </div>

        <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4">
          <label class="inline-flex items-center gap-3 text-sm text-slate-700">
            <%= f.check_box :active, class: "size-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
            Ativo disponivel para uso
          </label>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <%= f.button :submit, class: ButtonComponent::VARIANT_STYLES[:primary] %>
          <%= render ButtonComponent.new(label: "Cancelar", href: investments_assets_path, variant: :soft_olive) %>
        </div>
      <% end %>
    </div>
  </section>
</div>
