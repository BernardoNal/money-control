<% classification_labels = {
  "dividends" => "Dividendos",
  "jcp" => "JCP",
  "fii_income" => "Rendimento de FII",
  "stock_lending" => "Aluguel de ativos",
  "amortization" => "Amortização",
  "tax" => "Imposto",
  "fee" => "Taxa",
  "reimbursement" => "Reembolso de evento",
  "other" => "Outro"
} %>
<div class="mx-auto w-full max-w-7xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <%= render ButtonComponent.new(label: "Voltar para a carteira", href: investments_portfolio_path(@portfolio), variant: :soft_olive, icon: "fa-solid fa-arrow-left") %>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Revisão da importação</p>
        <h1 class="mt-3 text-3xl font-semibold text-slate-950"><%= @income_import.original_filename %></h1>
        <p class="mt-2 text-slate-600">Carteira: <%= @portfolio.name %></p>
      </div>
      <p class="text-sm text-slate-500">Nenhum recebível foi criado ainda.</p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% { "valid" => ["Válidas", "text-emerald-700"], "invalid" => ["Com erro", "text-red-700"], "requires_review" => ["Revisão manual", "text-amber-700"] }.each do |key, (label, color)| %>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
          <p class="text-sm text-slate-500"><%= label %></p>
          <p class="mt-1 text-2xl font-semibold <%= color %>"><%= @income_import.summary[key].to_i %></p>
        </div>
      <% end %>
    </div>

    <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200">
      <table class="min-w-[1050px] divide-y divide-slate-200 text-left text-sm">
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-3">Movimentação</th>
            <th class="px-4 py-3">Liquidação</th>
            <th class="px-4 py-3">Lançamento</th>
            <th class="px-4 py-3">Ativo</th>
            <th class="px-4 py-3">Valor</th>
            <th class="px-4 py-3">Classificação</th>
            <th class="px-4 py-3">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @income_import.rows.each do |row| %>
            <% valid = row["status"] == "valid" %>
            <% value_color = row["amount"].to_s.to_f.negative? ? "text-rose-600" : "text-emerald-700" %>
            <tr>
              <td class="px-4 py-4 text-slate-700"><%= row["movement_date"].present? ? Date.parse(row["movement_date"]).strftime("%d/%m/%Y") : "-" %></td>
              <td class="px-4 py-4 text-slate-700"><%= row["settlement_date"].present? ? Date.parse(row["settlement_date"]).strftime("%d/%m/%Y") : "-" %></td>
              <td class="max-w-md px-4 py-4 font-medium text-slate-900"><%= row["description"].presence || row["ignored_reason"] || "-" %></td>
              <td class="px-4 py-4 font-semibold text-slate-700"><%= row["symbol"].presence || "-" %></td>
              <td class="px-4 py-4 font-semibold <%= value_color %>"><%= row["amount"].present? ? number_to_currency(row["amount"], unit: "R$ ", separator: ",", delimiter: ".") : "-" %></td>
              <td class="px-4 py-4 text-slate-700"><%= classification_labels.fetch(row["classification"], row["classification"].presence || "-") %></td>
              <td class="px-4 py-4">
                <% status_label = if !valid
                                    "Com erro"
                                  elsif row["requires_review"]
                                    "Revisão manual"
                                  else
                                    "Válida"
                                  end %>
                <% status_color = !valid ? "text-red-700" : row["requires_review"] ? "text-amber-700" : "text-emerald-700" %>
                <span class="font-semibold <%= status_color %>"><%= status_label %></span>
                <% if row["errors"].present? %><p class="mt-1 text-xs text-red-700"><%= row["errors"].to_sentence %></p><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
      Linhas marcadas para revisão manual ainda não podem ser transformadas em recebíveis. A confirmação e a edição serão adicionadas no próximo checkpoint.
    </div>
  </section>
</div>
