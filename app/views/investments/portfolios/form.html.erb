<div class="container mt-6 max-w-3xl">
  <%= link_to investments_portfolios_path, class: "inline-flex items-center gap-2 rounded-full bg-gray-900 px-4 py-2 text-sm text-white text-decoration-none transition hover:bg-gray-700" do %>
    <i class="fa-solid fa-circle-left"></i>Voltar
  <% end %>

  <div class="mt-5 overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm">
    <div class="border-b border-gray-100 bg-gradient-to-r from-slate-50 to-white px-6 py-5">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Investimentos</p>
      <h1 class="mt-2 text-3xl font-semibold text-gray-900">
        <%= @portfolio.persisted? ? "Editar Portfolio" : "Novo Portfolio" %>
      </h1>
      <p class="mt-2 max-w-xl text-sm text-gray-600">
        Organize seus ativos por estrategia ou contexto, como portfolio principal, cripto ou internacional.
      </p>
    </div>

    <div class="px-6 py-6">
      <%= form_with model: @portfolio, local: true do |f| %>
        <% if @portfolio.errors.any? %>
          <div class="mb-6 rounded-2xl border border-red-300 bg-red-50 p-4 text-red-700">
            <p class="font-semibold">Nao foi possivel salvar o portfolio:</p>
            <ul class="mt-2 list-disc pl-5">
              <% @portfolio.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-1 gap-5">
          <div class="w-full">
            <%= f.label :name, "Nome", class: "mb-2 block text-sm font-medium text-gray-900" %>
            <%= f.text_field :name,
                             class: "block w-full rounded-2xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-4 focus:ring-blue-100",
                             placeholder: "Ex.: Portfolio Principal",
                             required: true %>
            <p class="mt-2 text-sm text-gray-500">
              Use um nome curto e facil de identificar no dia a dia.
            </p>
          </div>
        </div>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm text-gray-500">
            Este portfolio ficara vinculado ao seu usuario autenticado.
          </p>

          <div class="flex items-center gap-3">
            <%= link_to "Cancelar", investments_portfolios_path, class: "rounded-full border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50" %>
            <%= f.button :submit, class: "rounded-full bg-blue-700 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-blue-800 focus:outline-none focus:ring-4 focus:ring-blue-300" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
