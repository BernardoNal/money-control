<div class="container mt-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">Meus Portfolios</h1>
    <%= link_to new_investments_portfolio_path, class: "text-gray-600" do %>
      <i class="fa-solid fa-circle-plus text-2xl"></i>
    <% end %>
  </div>

  <div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <% @portfolios.each do |portfolio| %>
      <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
        <h2 class="text-xl font-semibold text-gray-900"><%= portfolio.name %></h2>
        <p class="mt-2 text-sm text-gray-500">Criado em <%= l(portfolio.created_at.to_date) %></p>

        <div class="mt-4">
          <%= link_to investments_portfolio_path(portfolio), class: "inline-flex items-center px-3 py-2 text-center text-white bg-blue-600 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300" do %>
            Ver mais&nbsp;<i class="fa-solid fa-arrow-right"></i>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @portfolios.empty? %>
    <div class="mt-6 rounded-lg border border-dashed border-gray-300 bg-gray-50 p-6 text-center text-gray-600">
      Nenhum portfolio cadastrado ainda.
    </div>
  <% end %>
</div>
