<div class="mx-auto w-full max-w-7xl">
  <section class="rounded-[2rem] border border-slate-300 bg-white p-8 shadow-sm sm:p-10">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Investimentos</p>
        <h1 class="mt-3 text-3xl font-semibold text-slate-950">Meus portfolios</h1>
        <p class="mt-2 text-sm leading-6 text-slate-600">Acompanhe suas carteiras em um resumo mais claro antes de entrar na analise detalhada.</p>
      </div>

      <%= render ButtonComponent.new(label: "Novo portfolio", href: investments_portfolios_path(modal: "new"), variant: :primary, icon: "fa-solid fa-circle-plus") %>
    </div>

    <% if @portfolios.any? %>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        <% @portfolios.each do |portfolio| %>
          <% summary = @portfolio_summaries[portfolio.id] %>
          <% invested_amount = summary.total_invested_amount.to_d %>
          <% current_value = summary.current_portfolio_value.to_d %>
          <% variation_amount = current_value - invested_amount %>
          <% variation_percentage = invested_amount.zero? ? 0 : ((variation_amount / invested_amount) * 100) %>
          <% positive_variation = variation_amount.positive? %>
          <% negative_variation = variation_amount.negative? %>
          <article class="rounded-3xl border border-slate-500 bg-slate-300  p-6 shadow-sm">
            <div>
              <div class="flex items-start justify-between gap-3">
                <h2 class="text-lg font-semibold text-slate-950"><%= portfolio.name %></h2>
                <%= link_to investments_portfolios_path(modal: "edit", portfolio_id: portfolio.id),
                            class: "inline-flex h-10 w-10 items-center justify-center rounded-2xl border border-slate-300 bg-white text-slate-500 no-underline transition hover:border-slate-400 hover:text-slate-950",
                            aria: { label: "Editar nome de #{portfolio.name}" } do %>
                  <i class="fa-solid fa-pen"></i>
                <% end %>
              </div>
            </div>

            <div class="mt-4 grid gap-5 sm:grid-cols-2">
              <div class="rounded-3xl bg-white px-5 py-5 shadow-lg ring-1 ring-slate-200">
                <p class="text-sm font-semibold tracking-[0.18em] text-slate-500">Investido</p>
                <p class="mt-4 whitespace-nowrap font-semibold leading-none text-slate-950"><%= number_to_currency(invested_amount, unit: "R$ ", separator: ",", delimiter: ".") %></p>
              </div>

              <div class="rounded-3xl bg-white px-5 py-5 shadow-lg ring-1 ring-slate-200">
                <p class="text-sm font-semibold tracking-[0.18em] text-slate-500">Atual</p>
                <p class="mt-4 inline-flex items-center gap-2 whitespace-nowrap font-semibold leading-none <%= positive_variation ? 'text-emerald-700' : negative_variation ? 'text-rose-700' : 'text-slate-950' %>">
                  <% if positive_variation %>
                    <i class="fa-solid fa-arrow-trend-up text-sm"></i>
                  <% elsif negative_variation %>
                    <i class="fa-solid fa-arrow-trend-down text-sm"></i>
                  <% else %>
                    <i class="fa-solid fa-minus text-sm text-slate-400"></i>
                  <% end %>
                  <span><%= number_to_currency(current_value, unit: "R$ ", separator: ",", delimiter: ".") %></span>
                </p>
              </div>
            </div>

            <div class="mt-5 rounded-3xl bg-white px-5 py-5 shadow-lg ring-1 ring-slate-200">
              <p class="text-sm font-semibold tracking-[0.18em] text-slate-500">Variação</p>
              <div class="mt-5 grid gap-5 sm:grid-cols-[auto_1fr] sm:items-end">
                <div class="<%= positive_variation ? 'text-emerald-700' : negative_variation ? 'text-rose-700' : 'text-slate-700' %>">
                  <p class="whitespace-nowrap font-semibold leading-none"><%= number_to_currency(variation_amount, unit: "R$ ", separator: ",", delimiter: ".") %></p>
                  <p class="mt-3 inline-flex w-fit rounded-full px-2.5 py-1 font-semibold ring-1 <%= positive_variation ? 'bg-emerald-100 text-emerald-700 ring-emerald-400' : negative_variation ? 'bg-rose-100 text-rose-700 ring-rose-400' : 'bg-slate-100 text-slate-600 ring-slate-400' %>">
                    <%= number_with_precision(variation_percentage, precision: 2, separator: ",", delimiter: ".") %>%
                  </p>
                </div>

                <div class="border-t border-slate-100 pt-4 text-xs leading-6 text-slate-500 sm:border-t-0 sm:border-l sm:pl-5 sm:pt-0">
                  Comparação entre valor atual e investido.
                </div>
              </div>
            </div>

            <div class="mt-7 flex flex-wrap gap-3">
              <%= render ButtonComponent.new(label: "Ver em detalhes", href: investments_portfolio_path(portfolio), variant: :primary, icon: "fa-solid fa-arrow-right", classes: "px-6" ) %>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="mt-8 rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center">
        <h2 class="text-xl font-semibold text-slate-950">Nenhum portfolio cadastrado</h2>
        <p class="mt-2 text-sm text-slate-600">Crie sua primeira carteira para acompanhar ativos, alocação e evolução patrimonial.</p>
        <div class="mt-6 flex justify-center">
          <%= render ButtonComponent.new(label: "Novo portfolio", href: investments_portfolios_path(modal: "new"), variant: :primary, icon: "fa-solid fa-circle-plus") %>
        </div>
      </div>
    <% end %>
  </section>
</div>

<% if @portfolio_modal.present? && @portfolio.present? %>
  <%= render "modal_form", portfolio: @portfolio, modal: @portfolio_modal %>
<% end %>
