<% modal_title = portfolio.persisted? ? "Editar portfolio" : "Novo portfolio" %>
<% modal_submit = portfolio.persisted? ? "Salvar alteracoes" : "Criar portfolio" %>
<% modal_path = portfolio.persisted? ? investments_portfolio_path(portfolio) : investments_portfolios_path %>
<% modal_method = portfolio.persisted? ? :patch : :post %>

<div class="fixed inset-0 z-50 flex items-center justify-center px-4 py-6 sm:px-6">
  <%= link_to investments_portfolios_path,
              class: "absolute inset-0 bg-slate-950/55 backdrop-blur-[2px]",
              aria: { label: "Fechar modal de portfolio" } do %>
  <% end %>

  <div class="relative z-10 w-full max-w-xl overflow-hidden rounded-[2rem] border border-slate-400 bg-white shadow-2xl">
    <div class="border-b border-slate-300 bg-gradient-to-r from-slate-50 to-white px-6 py-6 sm:px-8">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Investimentos</p>
          <h2 class="mt-3 text-2xl font-semibold text-slate-950"><%= modal_title %></h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Defina um nome curto para identificar essa carteira com mais facilidade.
          </p>
        </div>

        <%= link_to investments_portfolios_path,
                    class: "inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-slate-300 bg-white text-slate-500 no-underline transition hover:border-slate-400 hover:text-slate-950",
                    aria: { label: "Fechar modal" } do %>
          <i class="fa-solid fa-xmark"></i>
        <% end %>
      </div>
    </div>

    <div class="px-5 py-6 sm:px-8 sm:py-8">
      <%= form_with model: portfolio, url: modal_path, method: modal_method, local: true do |f| %>
        <% if portfolio.errors.any? %>
          <div class="mb-6 rounded-3xl border border-rose-300 bg-rose-50 px-5 py-4 text-rose-700">
            <p class="font-semibold">Nao foi possivel salvar o portfolio:</p>
            <ul class="mt-2 list-disc pl-5 text-sm">
              <% portfolio.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="rounded-3xl border border-slate-300 bg-slate-50 p-5 sm:p-6">
          <%= hidden_field_tag :modal, modal %>
          <%= hidden_field_tag :portfolio_id, portfolio.id if portfolio.persisted? %>

          <%= f.label :name, "Nome", class: "mb-2 block text-sm font-medium" %>
          <%= f.text_field :name,
                           class: "w-full bg-white",
                           placeholder: "Ex.: Portfolio Principal",
                           required: true,
                           autofocus: true %>

          <div class="mt-3 flex flex-col gap-2 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between">
            <p>Use um nome simples e facil de reconhecer.</p>
            <span class="inline-flex items-center gap-2 rounded-full border border-slate-300 bg-white px-3 py-1 text-xs font-medium text-slate-600">
              <i class="fa-solid fa-user-lock text-[11px]"></i>
              Vinculado ao seu usuario
            </span>
          </div>
        </div>

        <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end">
          <%= render ButtonComponent.new(label: "Cancelar", href: investments_portfolios_path, variant: :soft_olive) %>
          <%= f.button modal_submit, class: ButtonComponent::VARIANT_STYLES[:primary] %>
        </div>
      <% end %>
    </div>
  </div>
</div>
