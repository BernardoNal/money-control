<% currency_unit = { "BRL" => "R$ ", "USD" => "$ ", "EUR" => "€ " }.fetch(@detail.asset.currency, "#{@detail.asset.currency} ") %>
<% profit_loss_positive = @detail.unrealized_profit_loss.positive? %>
<% profit_loss_negative = @detail.unrealized_profit_loss.negative? %>
<% profit_loss_tone = profit_loss_positive ? "text-emerald-700" : profit_loss_negative ? "text-rose-700" : "text-slate-700" %>
<% price_above_average = @detail.market_price && @detail.market_price > @detail.average_price %>
<% price_below_average = @detail.market_price && @detail.market_price < @detail.average_price %>
<% price_tone = price_above_average ? "text-emerald-600" : price_below_average ? "text-rose-600" : "text-slate-700" %>
<% price_icon = price_above_average ? "fa-solid fa-arrow-trend-up" : price_below_average ? "fa-solid fa-arrow-trend-down" : nil %>

<div class="mx-auto w-full max-w-7xl">
  <div class="overflow-hidden rounded-[2rem] border border-slate-400 bg-white shadow-sm">
    <div class="border-b border-slate-300 bg-gradient-to-r from-slate-50 to-white px-6 py-6 lg:px-8">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <%= render ButtonComponent.new(label: "Voltar para carteira", href: investments_portfolio_path(@portfolio, tab: "holdings"), variant: :soft_olive, icon: "fa-solid fa-arrow-left") %>
          <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1">
            <p class="text-sm font-semibold uppercase tracking-[0.22em] text-slate-500">Detalhes do ativo</p>
            <span class="text-sm text-slate-600">Carteira: <strong class="font-semibold text-slate-900"><%= @portfolio.name %></strong></span>
          </div>
          <div class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h1 class="text-3xl font-semibold text-slate-950"><%= @detail.asset.symbol %></h1>
            <span class="text-lg text-slate-600"><%= @detail.asset.name %></span>
          </div>
          <p class="mt-2 text-sm text-slate-600">
            <%= @detail.asset.human_category %> · <%= @detail.asset.human_subcategory %> · <%= @detail.asset.currency %>
          </p>
        </div>

        <div class="mt-6 rounded-2xl bg-[#000080] px-6 py-5 lg:mt-0 lg:min-w-[28rem] lg:max-w-md lg:text-center">
          <p class="text-sm text-white">
            <%= @detail.price_as_of ? "Valor até #{l(@detail.price_as_of.to_date)}" : "Valor atual" %>
          </p>
          <p class="mt-1 text-4xl font-semibold tracking-tight text-white"><%= privacy_value(number_to_currency(@detail.current_market_value, unit: currency_unit, separator: ",", delimiter: ".")) %></p>
          <p class="mt-2 text-sm text-white">Quantidade: <span class="font-semibold text-white"><%= privacy_value(number_with_precision(@detail.quantity, precision: 8, strip_insignificant_zeros: true)) %></span></p>
        </div>
      </div>
    </div>

    <div class="px-6 py-7 lg:px-8 lg:py-8">
      <% if @detail.quantity.zero? %>
        <div class="mb-6 rounded-2xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800">
          Não há posição atual neste ativo. Os valores abaixo representam o custo histórico registrado.
        </div>
      <% end %>

      <% if @detail.price_source != :market %>
        <div class="mb-6 rounded-2xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800">
          Cotação de mercado indisponível. O valor atual usa o custo médio como referência.
        </div>
      <% end %>

      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        <div class="rounded-2xl border border-slate-300 bg-slate-50 p-5">
          <p class="text-sm text-slate-500">Preço atual</p>
          <p class="mt-3 flex items-center gap-2 text-2xl font-semibold <%= price_tone %>">
            <% if price_icon %>
              <i class="<%= price_icon %> text-lg" aria-hidden="true"></i>
            <% end %>
            <%= @detail.market_price ? privacy_value(number_to_currency(@detail.market_price, unit: currency_unit, separator: ",", delimiter: ".")) : "-" %>
          </p>
        </div>

        <div class="rounded-2xl border border-slate-300 bg-slate-50 p-5">
          <p class="text-sm text-slate-500">Preço médio</p>
          <p class="mt-3 text-2xl font-semibold text-slate-950"><%= privacy_value(number_to_currency(@detail.average_price, unit: currency_unit, separator: ",", delimiter: ".")) %></p>
        </div>

        <div class="rounded-2xl border border-slate-300 bg-slate-50 p-5">
          <p class="text-sm text-slate-500">Total investido</p>
          <p class="mt-3 text-2xl font-semibold text-slate-950"><%= privacy_value(number_to_currency(@detail.total_invested_amount, unit: currency_unit, separator: ",", delimiter: ".")) %></p>
        </div>
      </div>

      <div class="mt-6">
        <div class="rounded-2xl border border-slate-300 bg-white p-5">
          <p class="text-sm text-slate-500">Resultado não realizado</p>
          <div class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1 <%= profit_loss_tone %>">
            <span class="text-3xl font-semibold"><%= privacy_value(number_to_currency(@detail.unrealized_profit_loss, unit: currency_unit, separator: ",", delimiter: ".")) %></span>
            <span class="text-lg font-medium">(<%= privacy_value("#{number_with_precision(@detail.unrealized_profit_loss_percentage, precision: 2)}%") %>)</span>
          </div>
          <p class="mt-2 text-sm text-slate-500">Diferença entre o valor atual e o total investido.</p>
        </div>
      </div>

      <% if @detail.annual_comparison %>
        <% annual_change_positive = @detail.annual_comparison.change.positive? %>
        <% annual_change_negative = @detail.annual_comparison.change.negative? %>
        <% annual_change_tone = annual_change_positive ? "text-emerald-700" : annual_change_negative ? "text-rose-700" : "text-slate-700" %>
        <div class="mt-6 rounded-2xl border border-slate-300 bg-white p-5">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-sm text-slate-500">Variação de valor desde <%= l(@detail.annual_comparison.reference_date) %></p>
            </div>
          </div>

          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            <div>
              <p class="text-xs uppercase tracking-wide text-slate-500">Valor em <%= l(@detail.annual_comparison.reference_date) %></p>
            <p class="mt-1 font-semibold text-slate-900"><%= privacy_value(number_to_currency(@detail.annual_comparison.reference_value, unit: currency_unit, separator: ",", delimiter: ".")) %></p>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wide text-slate-500">Valor atual</p>
            <p class="mt-1 font-semibold text-slate-900"><%= privacy_value(number_to_currency(@detail.annual_comparison.current_value, unit: currency_unit, separator: ",", delimiter: ".")) %></p>
            </div>
            <div>
              <p class="text-xs uppercase tracking-wide text-slate-500">Variação</p>
              <p class="mt-1 font-semibold <%= annual_change_tone %>">
                <%= privacy_value(number_to_currency(@detail.annual_comparison.change, unit: currency_unit, separator: ",", delimiter: ".")) %>
                (<%= privacy_value("#{number_with_precision(@detail.annual_comparison.change_percentage, precision: 2)}%") %>)
              </p>
            </div>
          </div>
        </div>
      <% end %>

      <section id="performance-heading" class="mt-6 scroll-mt-6 rounded-2xl border border-slate-300 bg-white p-5 lg:p-6" aria-labelledby="performance-title">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <h2 id="performance-title" class="text-lg font-semibold text-slate-950">Evolução da posição</h2>
            <p class="mt-1 text-sm text-slate-500">Compare o custo investido com o valor de mercado do ativo.</p>
          </div>
          <% performance_return_positive = @performance.total_return.positive? %>
          <% performance_return_negative = @performance.total_return.negative? %>
          <% performance_return_tone = performance_return_positive ? "text-emerald-700" : performance_return_negative ? "text-rose-700" : "text-slate-700" %>
          <% performance_return_percentage = @performance.total_invested_amount.zero? ? 0 : (@performance.total_return / @performance.total_invested_amount * 100) %>
          <div class="text-left sm:text-right">
            <p class="text-sm text-slate-500">Retorno total</p>
            <p class="mt-1 text-2xl font-semibold <%= performance_return_tone %>"><%= privacy_value(number_to_currency(@performance.total_return, unit: currency_unit, separator: ",", delimiter: ".")) %></p>
            <p class="text-sm font-medium <%= performance_return_tone %>"><%= privacy_value("#{number_with_precision(performance_return_percentage, precision: 2)}%") %></p>
          </div>
        </div>

        <div class="mt-5 flex flex-wrap gap-2" role="tablist" aria-label="Período da evolução da posição">
          <% Investments::PortfolioAssetsController::PERFORMANCE_PERIODS.each do |period_key, period_label| %>
            <% selected_period = period_key == performance_period %>
            <%= link_to request.query_parameters.merge(performance_period: period_key, anchor: "performance-heading"),
                        role: "tab",
                        aria: { selected: selected_period },
                        class: "rounded-full border px-4 py-2 text-sm font-medium transition #{selected_period ? 'border-[#000080] bg-[#000080] text-white' : 'border-slate-300 bg-white text-slate-700 hover:border-slate-400'}" do %>
              <%= period_label %>
            <% end %>
          <% end %>
        </div>

        <% if @performance_history.points.any? %>
          <% performance_points = @performance_history.points %>
          <% chart_width = 900 %>
          <% chart_height = 300 %>
          <% chart_padding_left = 76 %>
          <% chart_padding_right = 24 %>
          <% chart_padding_top = 24 %>
          <% chart_padding_bottom = 48 %>
          <% chart_plot_width = chart_width - chart_padding_left - chart_padding_right %>
          <% chart_plot_height = chart_height - chart_padding_top - chart_padding_bottom %>
          <% chart_values = performance_points.flat_map { |point| [point.market_value.to_d, point.invested_amount.to_d] } %>
          <% chart_min_value = chart_values.min || 0.to_d %>
          <% chart_max_value = chart_values.max || 0.to_d %>
          <% chart_range = chart_max_value - chart_min_value %>
          <% chart_range = 1.to_d if chart_range.zero? %>
          <% chart_step = performance_points.length > 1 ? chart_plot_width.to_f / (performance_points.length - 1) : 0 %>
          <% chart_points = performance_points.each_with_index.map do |point, index| %>
            <% x = chart_padding_left + (index * chart_step) %>
            <% market_y = chart_padding_top + ((chart_max_value - point.market_value.to_d) / chart_range * chart_plot_height).to_f %>
            <% invested_y = chart_padding_top + ((chart_max_value - point.invested_amount.to_d) / chart_range * chart_plot_height).to_f %>
            <% { x: x, market_y: market_y, invested_y: invested_y, point: point } %>
          <% end %>
          <% chart_reference_values = 4.times.map { |index| chart_max_value - (chart_range * index / 3) } %>
          <div class="mt-6 rounded-2xl border border-slate-200 bg-slate-50 p-4 lg:p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h3 class="font-semibold text-slate-900">Custo x valor de mercado</h3>
                <p class="mt-1 text-sm text-slate-500">A diferença entre as linhas mostra a valorização ou desvalorização da posição.</p>
              </div>
              <div class="flex flex-wrap gap-4 text-xs text-slate-600" aria-label="Legenda do gráfico">
                <span class="flex items-center gap-2"><i class="h-2.5 w-2.5 rounded-full bg-[#2563eb]" aria-hidden="true"></i>Valor de mercado</span>
                <span class="flex items-center gap-2"><i class="h-2.5 w-2.5 rounded-full bg-[#0f766e]" aria-hidden="true"></i>Custo investido</span>
              </div>
            </div>

            <div class="mt-4 overflow-x-auto">
              <svg class="h-72 min-w-[42rem] w-full" viewBox="0 0 <%= chart_width %> <%= chart_height %>" role="img" aria-label="Comparação entre custo investido e valor de mercado do ativo">
                <% chart_reference_values.each_with_index do |reference_value, index| %>
                  <% reference_y = chart_padding_top + (index * chart_plot_height / 3.0) %>
                  <line x1="<%= chart_padding_left %>" y1="<%= reference_y %>" x2="<%= chart_width - chart_padding_right %>" y2="<%= reference_y %>" stroke="#cbd5e1" stroke-width="1.5" />
                  <text data-sensitive-chart-value data-sensitive-chart-visible-value="<%= number_to_currency(reference_value, unit: currency_unit, separator: ",", delimiter: ".") %>" x="<%= chart_padding_left - 10 %>" y="<%= reference_y + 4 %>" text-anchor="end" fill="#64748b" font-size="11"><%= number_to_currency(reference_value, unit: currency_unit, separator: ",", delimiter: ".") %></text>
                <% end %>
                <polyline points="<%= chart_points.map { |point| "#{point[:x]},#{point[:market_y]}" }.join(" ") %>" fill="none" stroke="#2563eb" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" />
                <polyline points="<%= chart_points.map { |point| "#{point[:x]},#{point[:invested_y]}" }.join(" ") %>" fill="none" stroke="#0f766e" stroke-dasharray="7 5" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" />
                <% chart_points.each_with_index do |chart_point, index| %>
                  <% next unless index.zero? || index == chart_points.length - 1 || index == chart_points.length / 2 %>
                  <circle cx="<%= chart_point[:x] %>" cy="<%= chart_point[:market_y] %>" r="5" fill="#2563eb">
                    <title data-sensitive-chart-value data-sensitive-chart-visible-value="<%= l(chart_point[:point].date) %> — valor de mercado: <%= number_to_currency(chart_point[:point].market_value, unit: currency_unit, separator: ",", delimiter: ".") %>"><%= l(chart_point[:point].date) %> — valor de mercado: <%= number_to_currency(chart_point[:point].market_value, unit: currency_unit, separator: ",", delimiter: ".") %></title>
                  </circle>
                  <circle cx="<%= chart_point[:x] %>" cy="<%= chart_point[:invested_y] %>" r="4" fill="#0f766e">
                    <title data-sensitive-chart-value data-sensitive-chart-visible-value="<%= l(chart_point[:point].date) %> — custo investido: <%= number_to_currency(chart_point[:point].invested_amount, unit: currency_unit, separator: ",", delimiter: ".") %>"><%= l(chart_point[:point].date) %> — custo investido: <%= number_to_currency(chart_point[:point].invested_amount, unit: currency_unit, separator: ",", delimiter: ".") %></title>
                  </circle>
                  <text x="<%= chart_point[:x] %>" y="<%= chart_height - 14 %>" text-anchor="middle" fill="#64748b" font-size="11"><%= chart_point[:point].date.strftime("%m/%y") %></text>
                <% end %>
              </svg>
            </div>

            <div class="mt-4 grid gap-3 border-t border-slate-200 pt-4 text-sm sm:grid-cols-3">
              <span class="text-slate-600">Custo investido: <strong class="text-slate-900"><%= privacy_value(number_to_currency(@performance.total_invested_amount, unit: currency_unit, separator: ",", delimiter: ".")) %></strong></span>
              <span class="text-slate-600">Recebíveis líquidos: <strong class="text-emerald-700"><%= privacy_value(number_to_currency(@performance.income_total, unit: currency_unit, separator: ",", delimiter: ".")) %></strong></span>
              <span class="text-slate-600">Período: <strong class="text-slate-900"><%= l(@performance_history.from_date) %> a <%= l(@performance_history.to_date) %></strong></span>
            </div>
          </div>
        <% else %>
          <div class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center">
            <i class="fa-solid fa-chart-line text-2xl text-slate-300" aria-hidden="true"></i>
            <p class="mt-3 text-sm text-slate-600">Não há histórico de cotações disponível para comparar custo e valor de mercado.</p>
          </div>
        <% end %>
      </section>

      <details id="transaction-history" class="mt-6 scroll-mt-6 rounded-2xl border border-slate-300 bg-white p-5 lg:p-6" open>
        <summary class="flex cursor-pointer list-none items-end justify-between gap-3">
          <div>
            <h2 class="text-lg font-semibold text-slate-950">Histórico de transações</h2>
            <p class="mt-1 text-sm text-slate-500">Movimentações deste ativo nesta carteira, da mais antiga para a mais recente.</p>
          </div>
          <span class="flex items-center gap-2 text-sm text-slate-500">
            <%= @asset_transactions_total %> movimentações
            <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
          </span>
        </summary>

        <% if @asset_transactions.any? %>
          <div class="mt-5 overflow-x-auto">
            <table class="min-w-full text-left text-sm">
              <thead class="border-b border-slate-300 text-slate-500">
                <tr>
                  <th class="py-3 pr-6 font-medium">Data</th>
                  <th class="py-3 pr-6 font-medium">Tipo</th>
                  <th class="py-3 pr-6 font-medium">Quantidade</th>
                  <th class="py-3 pr-6 font-medium">Preço</th>
                  <th class="py-3 pr-6 font-medium">Total</th>
                  <th class="py-3 pr-6 font-medium">Taxas</th>
                </tr>
              </thead>
              <tbody>
                <% @asset_transactions.each do |transaction| %>
                  <% transaction_type_tone =
                    case transaction.transaction_type
                    when "buy" then "text-emerald-700"
                    when "sell" then "text-rose-700"
                    else "text-slate-700"
                    end
                  %>
                  <tr class="border-b border-slate-100 last:border-b-0">
                    <td class="whitespace-nowrap py-4 pr-6 text-slate-700"><%= l(transaction.date) %></td>
                    <td class="py-4 pr-6">
                      <span class="font-medium <%= transaction_type_tone %>">
                        <%= t("activerecord.attributes.investments/transaction.transaction_types.#{transaction.transaction_type}") %>
                      </span>
                      <% if transaction.notes.present? %>
                        <p class="mt-1 max-w-xs text-xs text-slate-500"><%= transaction.notes %></p>
                      <% end %>
                    </td>
                    <td class="whitespace-nowrap py-4 pr-6 text-slate-700"><%= privacy_value(number_with_precision(transaction.quantity, precision: 8, strip_insignificant_zeros: true)) %></td>
                    <td class="whitespace-nowrap py-4 pr-6 text-slate-700">
                      <%= transaction.price.present? ? privacy_value(number_to_currency(transaction.price, unit: currency_unit, separator: ",", delimiter: ".")) : "—" %>
                    </td>
                    <td class="whitespace-nowrap py-4 pr-6 font-medium text-slate-900">
                      <%= transaction.price.present? ? privacy_value(number_to_currency(transaction.price * transaction.quantity, unit: currency_unit, separator: ",", delimiter: ".")) : "—" %>
                    </td>
                    <td class="whitespace-nowrap py-4 pr-6 text-slate-700">
                      <%= transaction.fees.present? && transaction.fees != 0 ? privacy_value(number_to_currency(transaction.fees, unit: currency_unit, separator: ",", delimiter: ".")) : "—" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <% if @asset_transactions_total > @asset_transactions_page_size %>
            <% current_history_page = (@asset_transactions_offset / @asset_transactions_page_size) + 1 %>
            <% next_history_offset = @asset_transactions_offset + @asset_transactions_page_size %>
            <div class="mt-5 flex items-center justify-between gap-4 border-t border-slate-200 pt-4 text-sm">
              <% if @asset_transactions_offset.positive? %>
                <%= link_to "Anterior", request.query_parameters.merge(history_set: @asset_transactions_offset - @asset_transactions_page_size, anchor: "transaction-history"), class: "font-medium text-[#000080] hover:underline" %>
              <% else %>
                <span class="text-slate-400">Anterior</span>
              <% end %>

              <span class="text-slate-500">Página <%= current_history_page %></span>

              <% if next_history_offset < @asset_transactions_total %>
                <%= link_to "Próxima", request.query_parameters.merge(history_set: next_history_offset, anchor: "transaction-history"), class: "font-medium text-[#000080] hover:underline" %>
              <% else %>
                <span class="text-slate-400">Próxima</span>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="mt-5 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
            Nenhuma transação encontrada para este ativo nesta carteira.
          </div>
        <% end %>
      </details>

      <details id="income-history" class="mt-6 scroll-mt-6 rounded-2xl border border-slate-300 bg-white p-5 lg:p-6" open>
        <summary class="flex cursor-pointer list-none items-end justify-between gap-3">
          <div>
            <h2 class="text-lg font-semibold text-slate-950">Histórico de recebíveis</h2>
            <p class="mt-1 text-sm text-slate-500">Proventos deste ativo nesta carteira, agrupados por tipo.</p>
          </div>
          <span class="flex items-center gap-2 text-sm text-slate-500">
            <%= @asset_incomes.size %> recebimentos
            <i class="fa-solid fa-chevron-down text-xs" aria-hidden="true"></i>
          </span>
        </summary>

        <% if @asset_incomes_by_type.any? %>
          <% total_gross_amount = @asset_incomes.sum(&:gross_amount).to_d %>
          <% total_tax_amount = @asset_incomes.sum(&:tax_amount).to_d %>
          <% total_net_amount = @asset_incomes.sum(&:net_amount).to_d %>

          <div class="mt-5 grid gap-4 sm:grid-cols-3">
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
              <p class="text-sm text-slate-500">Total bruto</p>
              <p class="mt-2 text-xl font-semibold text-slate-900"><%= privacy_value(number_to_currency(total_gross_amount, unit: currency_unit, separator: ",", delimiter: ".")) %></p>
            </div>
            <div class="rounded-2xl border border-red-200 bg-red-50 p-4">
              <p class="text-sm text-red-600">Total de impostos</p>
              <p class="mt-2 text-xl font-semibold text-red-700"><%= privacy_value(number_to_currency(total_tax_amount, unit: currency_unit, separator: ",", delimiter: ".")) %></p>
            </div>
            <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4">
              <p class="text-sm text-emerald-700">Total líquido</p>
              <p class="mt-2 text-xl font-semibold text-emerald-700"><%= privacy_value(number_to_currency(total_net_amount, unit: currency_unit, separator: ",", delimiter: ".")) %></p>
            </div>
          </div>

          <div class="mt-6 flex gap-2 overflow-x-auto border-b border-slate-200 pb-2" role="tablist" aria-label="Tipos de recebíveis">
            <% @asset_incomes_by_type.each do |income_type, incomes| %>
              <% active_income_type = income_type == @selected_income_type %>
              <%= link_to request.query_parameters.merge(income_type_tab: income_type, income_history_set: 0, anchor: "income-history"),
                          role: "tab",
                          aria: { selected: active_income_type },
                          class: "whitespace-nowrap rounded-full border px-4 py-2 text-sm font-medium transition #{active_income_type ? 'border-[#000080] bg-[#000080] text-white' : 'border-slate-300 bg-white text-slate-700 hover:border-slate-400'}" do %>
                <%= incomes.first.human_income_type %> (<%= incomes.size %>)
              <% end %>
            <% end %>
          </div>

          <% selected_incomes = @asset_incomes_by_type.fetch(@selected_income_type, []) %>
          <% group_gross_amount = selected_incomes.sum(&:gross_amount).to_d %>
          <% group_tax_amount = selected_incomes.sum(&:tax_amount).to_d %>
          <% group_net_amount = selected_incomes.sum(&:net_amount).to_d %>
          <section class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-4 lg:p-5" role="tabpanel">
            <div class="flex flex-wrap items-end justify-between gap-3 border-b border-slate-200 pb-3">
              <h3 class="font-semibold text-slate-900"><%= selected_incomes.first.human_income_type %></h3>
              <p class="text-sm font-semibold text-emerald-700"><%= privacy_value(number_to_currency(group_net_amount, unit: currency_unit, separator: ",", delimiter: ".")) %> líquido</p>
            </div>

            <div class="mt-4 overflow-x-auto">
              <table class="min-w-full text-left text-sm">
                <thead class="border-b border-slate-200 text-slate-500">
                  <tr>
                    <th class="py-3 pr-6 font-medium">Pagamento</th>
                    <th class="py-3 pr-6 font-medium">Referência</th>
                    <th class="py-3 pr-6 font-medium">Bruto</th>
                    <th class="py-3 pr-6 font-medium">Imposto</th>
                    <th class="py-3 font-medium">Líquido</th>
                  </tr>
                </thead>
                <tbody>
                  <% @visible_asset_incomes.each do |income| %>
                    <tr class="border-b border-white last:border-b-0">
                      <td class="whitespace-nowrap py-3 pr-6">
                        <%= link_to l(income.payment_date), investments_income_path(income), class: "font-medium text-[#000080] hover:underline" %>
                      </td>
                      <td class="whitespace-nowrap py-3 pr-6 text-slate-600"><%= income.reference_date.present? ? l(income.reference_date) : "—" %></td>
                      <td class="whitespace-nowrap py-3 pr-6 text-slate-700"><%= privacy_value(number_to_currency(income.gross_amount, unit: currency_unit, separator: ",", delimiter: ".")) %></td>
                      <td class="whitespace-nowrap py-3 pr-6 text-red-600"><%= privacy_value(number_to_currency(income.tax_amount, unit: currency_unit, separator: ",", delimiter: ".")) %></td>
                      <td class="whitespace-nowrap py-3 font-semibold text-emerald-700"><%= privacy_value(number_to_currency(income.net_amount, unit: currency_unit, separator: ",", delimiter: ".")) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 border-t border-slate-200 pt-3 text-sm text-slate-600">
              <span>Bruto: <strong class="text-slate-900"><%= privacy_value(number_to_currency(group_gross_amount, unit: currency_unit, separator: ",", delimiter: ".")) %></strong></span>
              <span>Imposto: <strong class="text-red-600"><%= privacy_value(number_to_currency(group_tax_amount, unit: currency_unit, separator: ",", delimiter: ".")) %></strong></span>
              <span>Líquido: <strong class="text-emerald-700"><%= privacy_value(number_to_currency(group_net_amount, unit: currency_unit, separator: ",", delimiter: ".")) %></strong></span>
            </div>

            <% if @asset_income_total > @asset_income_page_size %>
              <% current_income_page = (@asset_income_offset / @asset_income_page_size) + 1 %>
              <% next_income_offset = @asset_income_offset + @asset_income_page_size %>
              <div class="mt-4 flex items-center justify-between gap-4 border-t border-slate-200 pt-4 text-sm">
                <% if @asset_income_offset.positive? %>
                  <%= link_to "Anterior", request.query_parameters.merge(income_type_tab: @selected_income_type, income_history_set: @asset_income_offset - @asset_income_page_size, anchor: "income-history"), class: "font-medium text-[#000080] hover:underline" %>
                <% else %>
                  <span class="text-slate-400">Anterior</span>
                <% end %>
                <span class="text-slate-500">Página <%= current_income_page %></span>
                <% if next_income_offset < @asset_income_total %>
                  <%= link_to "Próxima", request.query_parameters.merge(income_type_tab: @selected_income_type, income_history_set: next_income_offset, anchor: "income-history"), class: "font-medium text-[#000080] hover:underline" %>
                <% else %>
                  <span class="text-slate-400">Próxima</span>
                <% end %>
              </div>
            <% end %>
          </section>
        <% else %>
          <div class="mt-5 rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-6 text-center text-slate-600">
            Nenhum recebimento encontrado para este ativo nesta carteira.
          </div>
        <% end %>
      </details>
    </div>
  </div>
</div>
